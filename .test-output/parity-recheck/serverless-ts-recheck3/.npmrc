# Datrix TypeScript Workspace - pnpm Configuration
#
# These settings apply to the entire TypeScript workspace.
# They optimize pnpm behavior for code generation use cases.

# Automatically install peer dependencies
# (Generated code may not explicitly list all peer deps)
auto-install-peers=true

# Allow peer dependency version mismatches
# (Generated code uses catalog versions which may not perfectly align)
strict-peer-dependencies=false

# Use pnpm's default isolated node_modules structure
# (Don't hoist to root - keeps dependencies properly isolated per package)
shamefully-hoist=false

# Store location for pnpm cache (relative to workspace root)
# store-dir=.pnpm-store
