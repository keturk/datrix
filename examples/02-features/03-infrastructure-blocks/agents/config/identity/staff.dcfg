// Platform-managed identity provider for 'staff': the workforce principals that
// submit certificate scans (certificate-service.dtrx) and resolve support tickets
// (support-service.dtrx). Its "support-admins" group maps, in the support service,
// to the role that may approve or deny a refund, so it is the provider
// approvals.providers names in config/support-service.dcfg.
// mode = platformManaged: the generator resolves the target-native provider at
// generation time (docker → Zitadel, Azure → Entra, AWS → Cognito).
config identity staff {
  base {
    audience = "workforce";
    mode = "platformManaged";
    jwksCacheTtlSeconds = 3600;
  }

  profile development as "dev" extends base {
  }

  profile test as "test" extends base {
  }

  profile staging as "stg" extends base {
  }

  profile production as "prod" extends base {
  }

  profile aws as "aws" extends base {
  }

  // Entra ID registers a browser app for a human audience, so the origin the
  // staff console redirects back to is declared here -- redirect URIs are never
  // derived from service names or ports.
  profile azure as "azure" extends base {
    publicClient {
      baseUrls {
        azure = "https://staff.credentials.example.com";
      }
      flows = ["authorization_code"];
    }
  }
}
