config service credentials.SupportService {
  base {
    port = 8001;
    flavor = "compose";
    replicas = 1;
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms db {
      id = "2c1e3f4a-5b6c-47d8-9e10-1a2b3c4d5e6f";
      engine = "postgres";
      flavor = "container";
      host = "localhost";
      port = 5432;
      database = "credentials_support";
      poolSize = 20;
      maxOverflow = 20;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
      dockerImage = "postgres:17-alpine";
      volumePath = "/var/lib/postgresql/data";
      defaultUser = "postgres";
    }
    queues {
      engine = "rabbitmq";
      flavor = "container";
      host = "localhost";
      port = 5672;
      managementPort = 15672;
      defaultUser = "guest";
      dockerImage = "rabbitmq:3-management-alpine";
      volumePath = "/var/lib/rabbitmq";
      healthCheckCmd = "rabbitmq-diagnostics -q ping";
    }
    registration {
      tags = ["api", "credentials", "v1"];
      meta = {};
      healthCheck {
        type = "http";
        path = "/health";
        interval = "10s";
      }
    }
    resilience {
      defaults {
        timeout = "10s";
        retry {
          maxAttempts = 2;
          backoff {
            type = "exponential";
            initial = "100ms";
            multiplier = 2;
          }
        }
      }
      dependencyPolicy {
        defaults {
          // Every live model handle is a resilient-client dependency: only a circuit
          // breaker and a bulkhead apply (the handle owns its timeout, and a model call
          // is never retried by the client). A replay handle is not a dependency.
          model {
            circuitBreaker {
              failureThreshold = 5;
              timeout = "30s";
            }
            bulkhead {
              maxConcurrent = 4;
            }
          }
        }
      }
    }
    httpSecurity {
      allowedHosts = ["support-service.example.com", "localhost"];
      corsOrigins = ["https://app.example.com"];
      corsMethods = ["GET", "POST", "PATCH", "DELETE", "OPTIONS"];
      corsHeaders = ["Authorization", "Content-Type"];
    }
    cacheOps {
      ttlSeconds = 300;
      keyMaxLength = 100;
      redisPoolSize = 10;
    }
    queueOps {
      sqsPollWaitSeconds = 20;
      sqsMaxMessagesPerPoll = 10;
      servicebusMaxWaitSeconds = 5;
    }
    kafkaOps {
      consumerPollTimeoutMs = 1000;
      keepalivePollTimeoutMs = 1000;
      maxPollIntervalMs = 600000;
    }
    messagingOps {
      rabbitmqPrefetchCount = 10;
    }
    downloadOps {
      timeoutSeconds = 300;
      chunkSizeBytes = 65536;
      maxRetries = 3;
      retryDelaySeconds = 1.0;
      retryableStatusCodes = [429, 500, 502, 503, 504];
    }
    remoteConfigOps {
      consulTimeoutSeconds = 5.0;
      appconfigMinPollSeconds = 15;
    }
    rateLimitOps {
      windowSeconds = 60;
    }
    microserviceClientOps {
      timeoutSeconds = 300;
      circuitBreakerFailMax = 5;
      circuitBreakerResetSeconds = 30;
      bulkheadMaxConcurrent = 10;
      integrationConnectTimeoutMs = 1000;
      integrationReadTimeoutMs = 30000;
      mailgunTimeoutSeconds = 30;
    }
    retryBudgetOps {
      window = 100;
      ratio = 0.1;
    }
    outboxOps {
      flushBatchSize = 500;
    }
    serviceCredentialOps {
      tokenExpirySkewSeconds = 30;
    }
    secrets {
      secret support_model_key {
        required = true;
        purpose = "API key for the hosted model behind the support agent's primary handle";
      }
    }
    agents support {
      models {
        primary {
          provider = "anthropic";               // API family, validated against installed platforms
          flavor = "direct";
          model = "claude-opus-5";
          maxOutputTokens = 4096;
          timeout = "90s";
          apiKey = "support_model_key";         // a logical secret handle (secrets { } above), never a value
          budget { perRun { tokens = 40000; wallclock = "3m"; } daily { tokens = 2000000; } }
        }
      }
      // Present only because the block declares an approval tool (refund): the role that may
      // decide, the provider(s) whose principals carry it, how long a request stays decidable,
      // when the sweep expires overdue requests, and whether the four approval endpoints join
      // the gateway's public route table (internal: reachable on the service only).
      approvals {
        approverRole = "supportAdmin";
        providers = ["staff"];
        timeout = "24h";
        sweepSchedule = "*/15 * * * *";
        exposure = "internal";
      }
    }
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
    replace agents support {                    // replace: a replay handle carries no transport keys,
      models {                                  // so the live handle's keys must not be inherited
        primary {
          provider = "replay";
          fixtures = "fixtures/agents/support/primary/";
          budget { perRun { tokens = 40000; wallclock = "3m"; } }
        }
      }
      approvals {
        approverRole = "supportAdmin";
        providers = ["staff"];
        timeout = "24h";
        sweepSchedule = "*/15 * * * *";
        exposure = "internal";
      }
    }
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";
    // The approval-decision consumer resumes a suspended agent loop bounded by
    // the handle's wallclock budget, so consumers run inside the ECS task
    // rather than as SQS-triggered Lambdas.
    runtime { consumers = "in-process"; }
    scaling {
      replicas {
        min = 1;
        max = 2;
      }
      triggers = [];
    }
    replace rdbms db {
      id = "2c1e3f4a-5b6c-47d8-9e10-1a2b3c4d5e6f";
      engine = "postgres";
      flavor = "rds";
      port = 5432;
      database = "credentials_support";
      poolSize = 20;
      maxOverflow = 20;
      ssl = true;
      instanceClass = "db.t3.medium";
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    replace queues {
      engine = "sqs";
      flavor = "sqs";
      region = "us-east-1";
    }
    replace agents support {                    // replace: a managed handle carries sizing only,
      models {                                  // never the direct flavor's credential key
        primary {
          provider = "anthropic";
          flavor = "managed";                   // the cloud's hosted Messages API, signed per
          model = "claude-opus-5";              // request with the task role -- no apiKey
          maxOutputTokens = 4096;
          timeout = "90s";
          budget { perRun { tokens = 40000; wallclock = "3m"; } daily { tokens = 2000000; } }
          managed { }                           // AWS provisions nothing per handle: no sizing keys
        }
      }
      approvals {                               // restated: replace drops every sibling key
        approverRole = "supportAdmin";
        providers = ["staff"];
        timeout = "24h";
        sweepSchedule = "*/15 * * * *";
        exposure = "internal";
      }
    }
  }

  profile azure as "azure" extends base {
    alias env = "AZURE";
    alias resource = "azure";
    scaling {
      replicas {
        min = 1;
        max = 2;
      }
      triggers = [];
    }
    replace rdbms db {
      id = "2c1e3f4a-5b6c-47d8-9e10-1a2b3c4d5e6f";
      engine = "postgres";
      flavor = "flexible-server";
      port = 5432;
      database = "credentials_support";
      poolSize = 20;
      maxOverflow = 20;
      ssl = true;
      sku = "Standard_B1ms";
      tier = "Burstable";
      storageGb = 32;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    replace queues {
      engine = "service-bus";
      flavor = "service-bus";
      sku = "Standard";
    }
    replace agents support {                    // replace: a managed handle carries sizing only,
      models {                                  // never the direct flavor's credential key
        primary {
          provider = "anthropic";
          flavor = "managed";                   // one Azure AI Foundry deployment, reached with
          model = "claude-opus-5";              // the service's managed identity -- no apiKey
          maxOutputTokens = 4096;
          timeout = "90s";
          budget { perRun { tokens = 40000; wallclock = "3m"; } daily { tokens = 2000000; } }
          managed {                             // sizing only: the platform's declared keys
            deploymentSku = "GlobalStandard";
            capacity = 25;                      // thousands of tokens per minute
            modelVersion = "1";                 // the Foundry catalog version, not the model id
          }
        }
      }
      approvals {                               // restated: replace drops every sibling key
        approverRole = "supportAdmin";
        providers = ["staff"];
        timeout = "24h";
        sweepSchedule = "*/15 * * * *";
        exposure = "internal";
      }
    }
  }
}
