
// Define a service in the 'library' namespace with version and description
service library.BookService('config/book-service.dcfg') : version('1.0.0'), description('Book management service') {

    // Service infrastructure configuration
    discovery { }                                              // Service discovery (auto-configured)

    // Enums define a fixed set of allowed values for type-safe fields
    enum BookStatus {
        Available,
        CheckedOut,
        Reserved,
        Maintenance
    }

    enum BookFormat {
        Hardcover,
        Paperback,
        eBook,
        Audiobook
    }

    // Relational database block - groups entities (tables) under a named datasource
    rdbms bookDb {

        // Abstract entities provide reusable field definitions; they don't generate tables
        abstract entity BaseEntity {
            // UUID is a semantic type for universally unique identifiers
            // 'primaryKey' marks this as the primary key; uuid() generates a default value
            UUID id : primaryKey, server = uuid();
            // @DateTime is a UTC datetime type; DateTime.now() sets the default to current UTC time
            DateTime createdAt : server = DateTime.now();
            DateTime updatedAt : server = DateTime.now();
        }

        // Concrete entity - inherits all fields from BaseEntity and maps to a database table
        entity Book extends BaseEntity {
            // String(200) = varchar with max 200 chars; 'trim' auto-trims whitespace on input
            // 'sortable' offers the field as a sortBy value of the resource's list;
            // 'filterable' adds it as an optional filter of that list
            String(200) title : trim, sortable, filterable;
            String(20) isbn;
            String(100) author : trim;
            Int publicationYear : sortable;
            // Enum fields enforce type safety; defaults use EnumName.Value syntax
            BookStatus status : filterable = BookStatus.Available;
            BookFormat format = BookFormat.Hardcover;
        }

    }

    // REST API block - generates CRUD endpoints and custom routes
    // basePath sets the URL prefix for all endpoints in this API
    rest_api BookServiceAPI : basePath("/api/v1"), rdbms(bookDb) {
        // 'resource' auto-generates standard CRUD endpoints (list, get, create, update, delete)
        resource bookDb.Book : auth(public);

        // A custom paged route: its optional parameters are its filters, and
        // sortable(...) names the fields a client may sort it by (sortBy/sortOrder)
        @path('/books/by-author')
        get booksByAuthor(String author, String? isbn, PageRequest page) : auth(public), sortable(title, publicationYear) -> Page<bookDb.Book> {
            return bookDb.Book.where(author: author).orderBy(createdAt: desc).page(page);
        }
    }

}
