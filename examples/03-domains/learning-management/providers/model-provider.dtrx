// The contract of the model behind the tutor: a question and the lesson go in, an answer and one
// structured fact come out. The application reads the reply as data and never acts on free text.
// config/providers/model-provider.dcfg says where it is served.
extern service lms.ModelProvider('config/providers/model-provider.dcfg')
    : version('1.0.0'), description('A model that answers from a lesson') {

    struct ModelQuestion {
        String(400) instructions;
        String(200) lessonTitle;
        Text lessonText;
        String(1000) question;
    }

    struct ModelAnswer {
        String(2000) text;
        /// The student is asking for their money back.
        Boolean wantsRefund;
    }

    rest_api ModelAPI : basePath('/v1') {
        @path('/answers')
        post answer(ModelQuestion request) -> ModelAnswer {
            ensure request.question != "";
        }
    }

    errors {
        ModelUnavailable(String message);
    }

    auth : apiKey(header: 'X-Model-Api-Key');
    health : path('/health');
}
