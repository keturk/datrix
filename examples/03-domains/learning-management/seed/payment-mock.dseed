// The key the enrollment service presents to the card vendor. The key itself is the development default
// of the service's secret; the vendor stores only its SHA-256 hash.
seed service lms.PaymentMock {
  rdbms paymentDb {
    baseline {
      ApiKey table on(keyHash) {
        id,                  keyHash,                                                            ownerId,                scopes,            isActive;
        @uuid("payment-key"), "4b161ab8b88281159d9ab5eff0d811af8802be84b6856312c90756e2b743d8f2", @uuid("owner-larkhill"), ["charges:write"], true;
      }
    }
  }
}
