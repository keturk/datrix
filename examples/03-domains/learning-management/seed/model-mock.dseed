// The key the tutor service presents to the model. The key itself is the development default of the
// service's secret; the vendor stores only its SHA-256 hash.
seed service lms.ModelMock {
  rdbms modelDb {
    baseline {
      ApiKey table on(keyHash) {
        id,                keyHash,                                                            ownerId,                scopes,            isActive;
        @uuid("model-key"), "6894bf501d06f7f4d6a88a6f95e6372fa1a2b2c754685958abd7f7ba17b6ec02", @uuid("owner-larkhill"), ["answers:write"], true;
      }
    }
  }
}
