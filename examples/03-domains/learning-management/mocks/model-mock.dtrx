// Stands in for the model. It implements the ModelProvider contract and follows a short script: a
// question about getting money back is a refund, anything else is answered with the opening of the
// lesson. It does not think, and a real model is one URL in config/providers/model-provider.dcfg away.
service lms.ModelMock('config/mocks/model-mock.dcfg')
    : version('1.0.0'), description('In-stack mock of the model') {

    discovery { }

    rdbms modelDb {

        /// One answer the model gave, for the Instructor app's vendor page.
        entity ModelCall extends BaseEntity {
            String(200) lessonTitle : filterable;
            String(1000) question;
            String(2000) answer;
            Boolean wantsRefund : filterable;
        }

        /// API keys the vendor issued. Only the SHA-256 hash of a key is stored.
        entity ApiKey extends BaseEntity {
            String(64) keyHash : unique;
            UUID ownerId : index;
            Array<String> scopes = [];
            Boolean isActive = true;
            DateTime? expiresAt;
            DateTime? lastUsedAt;
        }
    }

    struct ModelQuestion {
        String(400) instructions;
        String(200) lessonTitle;
        Text lessonText;
        String(1000) question;
    }

    struct ModelAnswer {
        String(2000) text;
        Boolean wantsRefund;
    }

    fn asksForRefund(String question) -> Boolean {
        let String asked = question.toLowerCase();
        return asked.contains("refund") || asked.contains("money back");
    }

    // The vendor's public API: exactly the ModelProvider contract.
    rest_api ModelAPI : basePath('/v1'), rdbms(modelDb) {
        @path('/answers')
        post answer(ModelQuestion request) : auth(required, providers: [modelKeys]) -> ModelAnswer {
            let Boolean wantsRefund = asksForRefund(request.question);
            let String text = wantsRefund
                ? "I have passed your request to your instructor, who will decide. You will get an email either way."
                : #"From {request.lessonTitle}: {request.lessonText.substring(0, 400)}";
            ModelCall.create({ lessonTitle: request.lessonTitle, question: request.question, answer: text, wantsRefund: wantsRefund });
            return ModelAnswer { text: text, wantsRefund: wantsRefund };
        }
    }

    // What the Instructor app shows: every answer the model gave.
    rest_api ModelDeskAPI : basePath('/api/v1/desk/model'), rdbms(modelDb) {
        resource ModelCall : only(list), auth(required, providers: [identity], roles: [operator]);
    }

    test("the script hears a request for money back") {
        assert asksForRefund("Can I have a refund please?");
        assert asksForRefund("I want my money back");
        assert !asksForRefund("Why do contour lines never cross?");
    }
}
