// Stands in for the model. It speaks the wire format of the provider the tutor's agents block names, and it
// follows a short script: a question about getting money back asks for the offerRefund tool, anything else
// reads the lesson and answers with its opening. It does not think, and a real model is one profile away
// (`production` in config/tutor-service.dcfg).
service lms.ModelMock('config/mocks/model-mock.dcfg')
    : version('1.0.0'), description('In-stack mock of the model') {

    discovery { }

    enum ModelMove {
        ReadLesson : tone(info),
        OfferRefund : tone(warning),
        Answer : tone(success)
    }

    rdbms modelDb {

        /// One turn the model took, for the Instructor app's vendor page.
        entity ModelCall extends BaseEntity {
            ModelMove move : filterable;
            String(2000) detail;
        }
    }

    // An agent's prompt carries each value it interpolates inside <data> delimiters.
    fn tagged(String text, String tag) -> String {
        return text.split(#"<{tag}><data>")[1].split("</data>")[0];
    }

    fn asksForRefund(String question) -> Boolean {
        let String asked = question.toLowerCase();
        return asked.contains("refund") || asked.contains("money back");
    }

    fn usage() -> JSON {
        return { input_tokens: 120, output_tokens: 40 };
    }

    fn callTool(String name, JSON input) -> JSON {
        return {
            type: "message",
            role: "assistant",
            stop_reason: "tool_use",
            content: [{ type: "tool_use", id: #"toolu_{Random.string(16)}", name: name, input: input }],
            usage: usage()
        };
    }

    fn finish(String text) -> JSON {
        modelDb.ModelCall.create({ move: ModelMove.Answer, detail: text });
        return {
            type: "message",
            role: "assistant",
            stop_reason: "end_turn",
            content: [{ type: "text", text: JSON.stringify({ text: text }) }],
            usage: usage()
        };
    }

    fn answerFrom(String toolResult) -> JSON {
        let JSON result = JSON.parse(toolResult);
        if (toolResult.contains("\"refunded\"")) {
            let String course = JSON.get(result, "courseTitle");
            return finish(#"Your instructor agreed. Your refund for {course} is on its way.");
        }
        let String title = JSON.get(result, "title");
        let String body = JSON.get(result, "body");
        return finish(#"From {title}: {body.substring(0, 400)}");
    }

    fn openingMove(String prompt) -> JSON {
        let String question = tagged(prompt, "question");
        if (asksForRefund(question)) {
            modelDb.ModelCall.create({ move: ModelMove.OfferRefund, detail: question });
            return callTool("offerRefund", { exchangeId: tagged(prompt, "exchange"), reason: "The student asked for their money back." });
        }
        modelDb.ModelCall.create({ move: ModelMove.ReadLesson, detail: question });
        return callTool("readLesson", { lessonId: tagged(prompt, "lesson") });
    }

    // The provider's public API. A handle sends no key over plain HTTP, by rule, so this route has none; it holds
    // nothing but its own script. The script looks at the newest message: a tool's result means it can answer.
    rest_api ModelAPI : basePath('/v1'), rdbms(modelDb) {
        @path('/messages')
        post messages(JSON request) : auth(public) -> JSON {
            let Array<JSON> turns = JSON.get(request, "messages");
            let Array<JSON> blocks = JSON.get(turns[turns.length - 1], "content");
            let JSON newest = blocks[blocks.length - 1];
            if (JSON.get(newest, "type") == "tool_result") {
                return answerFrom(JSON.get(newest, "content"));
            }
            return openingMove(JSON.get(newest, "text"));
        }
    }

    // What the Instructor app shows: every move the model made.
    rest_api ModelDeskAPI : basePath('/api/v1/desk/model'), rdbms(modelDb) {
        resource ModelCall : only(list), auth(required, providers: [identity], roles: [operator]);
    }

    test("the script hears a request for money back") {
        assert asksForRefund("Can I have a refund please?");
        assert asksForRefund("I want my money back");
        assert !asksForRefund("Why do contour lines never cross?");
    }

    test("the script reads a tagged value out of a prompt") {
        assert tagged("before <lesson><data>abc</data></lesson> after", "lesson") == "abc";
    }
}
