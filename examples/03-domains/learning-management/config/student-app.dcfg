config app lms.Student {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@larkhill";
      }
    }
    appId = "com.example.larkhill";
    strings = ["config/strings/student.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
