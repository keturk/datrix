// Larkhill Academy runs as one docker-compose stack on a developer machine: nginx in front, PostgreSQL,
// a self-hosted Zitadel for sign-in and the observability stack. `test`, `development` and `production`
// are the same stack; only the mocks' place in it is a choice, and that lives in config/providers/.
config system lms.System {
  base {
    schemaConvergence {
      enabled = true;
    }
    deployment {
      runtime = "docker-compose";
      provider = "local";
    }
    defaultTimeout = 30000;
    maxPageSize = 100;
    defaultLocale = "en-US";
    platforms {
      docker {
        kafka_default_retention_ms = 604800000;
        infra {
          defaultHealthcheck {
            interval = "10s";
            timeout = "10s";
            retries = 10;
            startPeriod = "30s";
          }
          kafkaHealthcheck {
            interval = "10s";
            timeout = "15s";
            retries = 20;
            startPeriod = "60s";
          }
          rabbitmqHealthcheck {
            interval = "10s";
            timeout = "15s";
            retries = 20;
            startPeriod = "60s";
          }
          jobWorkerHealthcheck {
            interval = "30s";
            timeout = "10s";
            retries = 3;
            startPeriod = "40s";
          }
          observabilityHealthcheck {
            interval = "15s";
            timeout = "10s";
            retries = 5;
            startPeriod = "30s";
          }
          pgbouncer {
            maxClientConn = 200;
            defaultPoolSize = 20;
          }
          initScript {
            maxRetries = 30;
            retryDelaySeconds = 2;
          }
          multiRdbmsStartPeriodSeconds = 120;
          // Desktop Docker hosts mount `/` privately, which the container-metrics collector's
          // host binds need, so this example declares the host most people run it on.
          sharedMountPropagation = false;
        }
      }
    }
    gateway {
      rateLimit {
        default {
          requests = 300;
          window = "1m";
          key = "ip";
        }
      }
      auth {
        jwt {
          algorithm = "RS256";
          issuer = "larkhill";
          expiresIn = 86400;
        }
      }
    }
    observability {
      metrics {
        provider = "prometheus";
        endpoint = "/metrics";
        includeDefault = true;
      }
      tracing {
        provider = "jaeger";
        samplingRate = 0.1;
      }
      logging {
        provider = "loki";
        level = "info";
        format = "json";
      }
      visualization {
        provider = "grafana";
      }
      alerting {
        provider = "alertmanager";
      }
    }
    zitadelIdentity {
      host = "zitadel";
      port = 8080;
      externalDomain = "localhost";
      externalSecure = false;
      adminUser = "admin";
      adminPassword = "identity_zitadel_admin_password";
      masterKey = "identity_zitadel_master_key";
      publicOrigins {
        test = "http://localhost:8085";
        development = "http://localhost:8085";
        production = "http://localhost:8085";
      }
      providers {
        identity {
          project = "larkhill-identity";
          clientId = "larkhill-identity-app";
        }
        machine {
          project = "larkhill-machine";
          clientId = "larkhill-machine-app";
        }
      }
    }
    configStore {
      engine = "file";
      flavor = "container";
      applicationName = "larkhill";
      environment = "local";
      profiles {
        settings {
          kind = "freeform";
          keys {
            Boolean debugMode : description("Enable debug mode.") = false;
          }
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
