config service lms.CourseService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    language = "python";  // TutorService's agent needs Python, and one system generates in one language.
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms courseDb from postgresContainer(id: "325c2c2f-260e-4c13-a760-74d4fdba828e", database: "lms_course");
    httpSecurity from localHttpSecurity(host: "lms-course-service");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
