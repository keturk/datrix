config service lms.ModelMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8092;
    language = "python";  // TutorService's agent needs Python, and one system generates in one language.
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms modelDb from postgresContainer(id: "2e803da2-dabf-48cc-bc93-081f33eb37c9", database: "lms_model_mock");
    httpSecurity from localHttpSecurity(host: "lms-model-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
