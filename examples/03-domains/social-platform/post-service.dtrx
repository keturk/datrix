from social.common import PostStatus;

// Posts and everything hanging off them. Every post goes past the moderation vendor before anyone sees it. If
// the vendor is down, the post waits for a person rather than being published unread. A short-lived counter in
// Redis slows down anyone posting too fast, without a database write for each attempt.
service social.PostService('config/post-service.dcfg') : version('2.0.0'), description('Posts, comments, likes and reports') {

    discovery { }

    uses PeopleService;
    uses ModerationProvider;

    exceptions {
        NoSuchPostError : status(404), message("That post is not here");
        NeedsHandleError : status(409), message("Choose a handle first");
        SuspendedError : status(403), message("Your account is suspended");
        RejectedError : status(422), message("That post breaks the rules, so it was not published");
        SlowDownError : status(429), message("You are posting too quickly. Try again in a minute");
        AlreadyDecidedError : status(409), message("Someone has already decided this");
    }

    enum ReportReason {
        Spam : tone(warning),
        Abuse : tone(danger),
        Other : tone(neutral)
    }

    enum ReportStatus {
        Open : tone(warning),
        Upheld : tone(danger),
        Dismissed : tone(neutral)
    }

    /// How many posts one person may make in the window the counter lives for.
    const POSTS_PER_MINUTE = 5;

    rdbms postDb {

        entity Post extends BaseEntity {
            String(80) authorName : filterable;
            String(30) authorHandle : index, filterable;
            Text body;
            PostStatus status : filterable = PostStatus.Published;
            Int likes = 0;
            Int comments = 0;
            /// Why the vendor would not publish it without a person looking.
            String(200)? heldReason;

            fulltext(body, authorName);
        }

        entity Comment extends BaseEntity {
            String(80) authorName;
            String(30) authorHandle;
            Text body;
            UUID postId : index;
        }

        entity Like extends BaseEntity {
            String(30) handle;
            UUID postId : index;

            index(postId, handle) : unique;
        }

        entity Hashtag extends BaseEntity {
            String(60) tag : unique;
            Int uses = 0;
        }

        entity TagUse extends BaseEntity {
            String(60) tag : index;
            UUID postId : index;

            index(tag, postId) : unique;
        }

        entity Report extends BaseEntity {
            String(200) excerpt;
            String(30) authorHandle : filterable;
            ReportReason reason : filterable;
            ReportStatus status : filterable = ReportStatus.Open;
            String(30) reporterHandle;
            UUID postId : index;
        }
    }

    cache redis {
        hash PostingWindow : prefix('posting:'), ttl(60) {
            String handle : key;
            Int count;
        }
    }

    pubsub mq {
        topic PostEvents {
            publish PostPublished(UUID postId, String authorHandle, String authorName, String excerpt);
            publish PostLiked(UUID postId, String authorHandle, String likerName, String excerpt);
            publish PostCommented(UUID postId, String authorHandle, String commenterName, String excerpt);
            publish PostRemoved(String authorHandle, String excerpt);
        }
    }

    struct NewPost {
        Text body;
    }

    struct NewComment {
        UUID postId;
        Text body;
    }

    struct NewReport {
        UUID postId;
        ReportReason reason;
    }

    struct PostPage {
        Post post;
        Array<Comment> comments;
    }

    struct TrendingTag {
        String tag;
        Int uses;
    }

    struct LikeCount {
        Int likes;
    }

    struct DeskSummary {
        Int held;
        Int openReports;
        Int publishedToday;
        Int removedThisWeek;
    }

    fn excerptOf(String body) -> String {
        return body.length > 140 ? body.substring(0, 140) : body;
    }

    fn authorFacts() -> AuthorFacts {
        let AuthorFacts facts = PeopleService.PeopleInternalAPI.post.author({ email: Auth.identity.email.toString() });
        if (!facts.exists) {
            throw NeedsHandleError();
        }
        if (facts.isSuspended) {
            throw SuspendedError();
        }
        return facts;
    }

    /// The counter is gone a minute after the first post, so the limit lifts by itself.
    fn slowDownIfNeeded(String handle) {
        let JSON? seen = redis.PostingWindow.get(handle);
        let Int count = seen != null ? JSON.get(seen, "count").toInteger() : 0;
        if (count >= POSTS_PER_MINUTE) {
            throw SlowDownError();
        }
        redis.PostingWindow.set(handle, { handle: handle, count: count + 1 });
    }

    /// Asking the vendor can only ever make a post wait. A vendor that does not answer never publishes.
    fn reviewed(String body, String key) -> ReviewResult {
        try {
            return ModerationProvider.ModerationAPI.post.review(ReviewRequest { text: body, idempotencyKey: key });
        } catch (Exception e) {
            Log.warn("Moderation did not answer", { key: key });
            return ReviewResult { id: "", verdict: Verdict.Hold, reason: "The moderation vendor did not answer" };
        }
    }

    fn indexTags(postDb.Post post) {
        foreach word in post.body.split(" ") {
            if (word.startsWith("#") && word.length > 1) {
                let String tag = word.substring(1, word.length).toLowerCase();
                if (postDb.TagUse.where(tag: tag, postId: post.id).first() == null) {
                    postDb.TagUse.create({ tag: tag, postId: post.id });
                    let postDb.Hashtag? known = postDb.Hashtag.where(tag: tag).first();
                    if (known == null) {
                        postDb.Hashtag.create({ tag: tag, uses: 1 });
                    } else {
                        known.uses = known.uses + 1;
                        known.save();
                    }
                }
            }
        }
    }

    /// Publishing is what makes a post public, so tags and followers hear about it only here.
    fn goLive(postDb.Post post) {
        post.status = PostStatus.Published;
        post.heldReason = null;
        post.save();
        indexTags(post);
        dispatch PostPublished(post.id, post.authorHandle, post.authorName, excerptOf(post.body));
    }

    fn visiblePost(UUID id) -> postDb.Post {
        let postDb.Post post = postDb.Post.findOrFail(id);
        if (post.status != PostStatus.Published) {
            throw NoSuchPostError();
        }
        return post;
    }

    // What anyone can read. Only a published post is ever here.
    rest_api PublicPostAPI : basePath('/api/v1/posts'), rdbms(postDb) {
        @path('/explore')
        get explore() : auth(public) -> Array<Post> {
            return Post.where(status: PostStatus.Published).orderBy(createdAt: desc).limit(50).all();
        }

        @path('/by/:handle')
        get byPerson(String handle) : auth(public) -> Array<Post> {
            return Post.where(authorHandle: handle, status: PostStatus.Published).orderBy(createdAt: desc).limit(50).all();
        }

        @path('/tagged/:tag')
        get tagged(String tag) : auth(public) -> Array<Post> {
            let Array<TagUse> uses = TagUse.where(tag: tag.toLowerCase()).orderBy(createdAt: desc).limit(50).all();
            let Array<UUID> ids = uses.map(u => u.postId);
            return Post.where(status: PostStatus.Published).whereIn(id: ids).orderBy(createdAt: desc).all();
        }

        @path('/search')
        get search(String q) : auth(public) -> Array<Post> {
            return Post.where(status: PostStatus.Published).fulltext(q).limit(30).all();
        }

        @path('/trending')
        get trending() : auth(public) -> Array<TrendingTag> {
            let Array<Hashtag> tags = Hashtag.orderBy(uses: desc).limit(8).all();
            return tags.map(t => TrendingTag { tag: t.tag, uses: t.uses });
        }

        @path('/post/:id')
        get postPage(UUID id) : auth(public) -> PostPage {
            let Post found = visiblePost(id);
            return PostPage { post: found, comments: Comment.where(postId: id).orderBy(createdAt: asc).limit(200).all() };
        }
    }

    // What someone signed in does.
    rest_api MyPostAPI : basePath('/api/v1/my/posts'), rdbms(postDb) {
        @path('/home')
        get home() : auth(required, providers: [identity]) -> Array<Post> {
            let AuthorFacts me = authorFacts();
            let Handles followed = PeopleService.PeopleInternalAPI.post.followingOf({ handle: me.handle });
            return Post.where(status: PostStatus.Published).whereIn(authorHandle: followed.handles).orderBy(createdAt: desc).limit(50).all();
        }

        @path('/mine')
        get mine() : auth(required, providers: [identity]) -> Array<Post> {
            let AuthorFacts me = authorFacts();
            return Post.where(authorHandle: me.handle).orderBy(createdAt: desc).limit(50).all();
        }

        @path('/new')
        post createPost(NewPost request) : auth(required, providers: [identity]) -> Post {
            let AuthorFacts me = authorFacts();
            slowDownIfNeeded(me.handle);
            let ReviewResult answer = reviewed(request.body, #"post-{me.handle}-{Random.string(16, '0123456789abcdef')}");
            if (answer.verdict == Verdict.Reject) {
                throw RejectedError();
            }
            let Post created = Post.create({
                authorName: me.displayName,
                authorHandle: me.handle,
                body: request.body,
                status: PostStatus.Held,
                heldReason: answer.reason
            });
            if (answer.verdict == Verdict.Allow) {
                goLive(created);
            }
            return created;
        }

        @path('/comment')
        post addComment(NewComment request) : auth(required, providers: [identity]) -> Comment {
            let AuthorFacts me = authorFacts();
            let Post post = visiblePost(request.postId);
            let Comment created = Comment.create({
                postId: post.id,
                authorName: me.displayName,
                authorHandle: me.handle,
                body: request.body
            });
            post.comments = post.comments + 1;
            post.save();
            if (post.authorHandle != me.handle) {
                dispatch PostCommented(post.id, post.authorHandle, me.displayName, excerptOf(post.body));
            }
            return created;
        }

        @path('/like/:id')
        post like(UUID id) : auth(required, providers: [identity]) -> LikeCount {
            let AuthorFacts me = authorFacts();
            let Post post = visiblePost(id);
            if (Like.where(postId: id, handle: me.handle).first() == null) {
                Like.create({ postId: id, handle: me.handle });
                post.likes = post.likes + 1;
                post.save();
                if (post.authorHandle != me.handle) {
                    dispatch PostLiked(post.id, post.authorHandle, me.displayName, excerptOf(post.body));
                }
            }
            return LikeCount { likes: post.likes };
        }

        @path('/report')
        post report(NewReport request) : auth(required, providers: [identity]) -> Report {
            let AuthorFacts me = authorFacts();
            let Post post = visiblePost(request.postId);
            return Report.create({
                postId: post.id,
                excerpt: excerptOf(post.body),
                authorHandle: post.authorHandle,
                reason: request.reason,
                reporterHandle: me.handle
            });
        }
    }

    // What a moderator does.
    rest_api PostDeskAPI : basePath('/api/v1/desk/posts'), rdbms(postDb) {
        resource Post : only(list), auth(required, providers: [identity], roles: [moderator]);
        resource Report : only(list), auth(required, providers: [identity], roles: [moderator]);

        @path('/summary')
        get summary() : auth(required, providers: [identity], roles: [moderator]) -> DeskSummary {
            let DateTime now = DateTime.now();
            return DeskSummary {
                held: Post.where(status: PostStatus.Held).count(),
                openReports: Report.where(status: ReportStatus.Open).count(),
                publishedToday: Post.where(status: PostStatus.Published).where(createdAt: gte(now.startOfDay())).count(),
                removedThisWeek: Post.where(status: PostStatus.Removed).where(updatedAt: gte(now.addDays(-7))).count()
            };
        }

        @path('/approve/:id')
        post approve(UUID id) : auth(required, providers: [identity], roles: [moderator]) -> Post {
            let Post post = Post.findOrFail(id);
            if (post.status != PostStatus.Held) {
                throw AlreadyDecidedError();
            }
            goLive(post);
            return post;
        }

        @path('/remove/:id')
        post remove(UUID id) : auth(required, providers: [identity], roles: [moderator]) -> Post {
            let Post post = Post.findOrFail(id);
            if (post.status == PostStatus.Removed) {
                throw AlreadyDecidedError();
            }
            post.status = PostStatus.Removed;
            post.save();
            dispatch PostRemoved(post.authorHandle, excerptOf(post.body));
            return post;
        }

        @path('/uphold/:id')
        post uphold(UUID id) : auth(required, providers: [identity], roles: [moderator]) -> Report {
            let Report report = Report.findOrFail(id);
            if (report.status != ReportStatus.Open) {
                throw AlreadyDecidedError();
            }
            report.status = ReportStatus.Upheld;
            report.save();
            let Post post = Post.findOrFail(report.postId);
            if (post.status != PostStatus.Removed) {
                post.status = PostStatus.Removed;
                post.save();
                dispatch PostRemoved(post.authorHandle, excerptOf(post.body));
            }
            return report;
        }

        @path('/dismiss/:id')
        post dismiss(UUID id) : auth(required, providers: [identity], roles: [moderator]) -> Report {
            let Report report = Report.findOrFail(id);
            if (report.status != ReportStatus.Open) {
                throw AlreadyDecidedError();
            }
            report.status = ReportStatus.Dismissed;
            report.save();
            return report;
        }
    }

    test("a short post is its own excerpt") {
        assert excerptOf("A short note.") == "A short note.";
    }

    test("a held post has not been published") {
        let postDb.Post created = postDb.Post.create({
            authorName: "A Tester",
            authorHandle: "tester",
            body: "A note.",
            status: PostStatus.Held,
            heldReason: "Testing"
        });
        assert created.status == PostStatus.Held;
        assert created.likes == 0;
    }
}
