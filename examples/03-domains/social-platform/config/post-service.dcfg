config service social.PostService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8002;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms postDb from postgresContainer(id: "3222afe5-4f9b-4a2d-9aa6-e78199fab662", database: "social_post");
    cache redis from redisContainer();
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "social-post-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    cacheOps from redisPool();
    rateLimitOps from rateLimitWindow();
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
          cache from standardCachePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in seed/, so the
      // example runs with nothing to configure. Any other deployment must supply the handle's value.
      secret moderation_provider_api_key {
        required = true;
        purpose = "API key for the moderation vendor (ModerationProvider contract).";
        localDefault = "dev-only-moderation-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
