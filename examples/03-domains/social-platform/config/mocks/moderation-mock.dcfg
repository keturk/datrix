config service social.ModerationMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8090;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms moderationDb from postgresContainer(id: "7ed3651b-c0ba-4d62-917c-7700aaab8695", database: "social_moderation_mock");
    httpSecurity from localHttpSecurity(host: "social-moderation-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
