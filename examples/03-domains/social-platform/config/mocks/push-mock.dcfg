config service social.PushMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8091;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms pushDb from postgresContainer(id: "66af5282-1b30-43b4-8556-a4a4545fca96", database: "social_push_mock");
    httpSecurity from localHttpSecurity(host: "social-push-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
