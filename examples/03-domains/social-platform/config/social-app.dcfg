config app social.Social {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@rookery";
      }
    }
    appId = "com.example.rookery";
    strings = ["config/strings/social.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
