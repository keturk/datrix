config service social.NoticeService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8003;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms noticeDb from postgresContainer(id: "43023774-611c-4781-adc9-37bdb075ccb3", database: "social_notice");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "social-notice-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    jobs {
      jobs {
        SendWeeklyDigest {
          schedule = "0 8 * * 1";
          timeout = "300s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The defaults only exist on a local stack, where they match the hashes seeded in seed/, so the
      // example runs with nothing to configure. Any other deployment must supply the handles' values.
      secret push_provider_api_key {
        required = true;
        purpose = "API key for the push vendor (PushProvider contract).";
        localDefault = "dev-only-push-key-not-a-credential";
      }
      secret email_provider_api_key {
        required = true;
        purpose = "API key for the email vendor (EmailProvider contract).";
        localDefault = "dev-only-email-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
