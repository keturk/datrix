// API keys of the push vendor. mode = self: PushMock issues and verifies them itself, and only the SHA-256
// hash of a key is stored.
config identity pushKeys {
  base {
    provider = "apiKey";
    mode = "self";
    audience = "customer";
    apiKey {
      header = "X-Push-Api-Key";
      store = "social.PushMock";
      storeBlock = "pushDb";
      entity = "ApiKey";
      fields {
        hash = "keyHash";
        owner = "ownerId";
        scopes = "scopes";
        active = "isActive";
        expiresAt = "expiresAt";
        lastUsedAt = "lastUsedAt";
      }
      lastUsedResolutionSeconds = 60;
      serviceProviders = ["machine"];
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
