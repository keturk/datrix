config service social.PeopleService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms peopleDb from postgresContainer(id: "59a67c0a-a028-410f-b954-6db30e9cb0d3", database: "social_people");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "social-people-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
