// The keys real devices report readings with. mode = self: TelemetryService issues and verifies them
// itself, and only the SHA-256 hash of a key is stored.
config identity deviceKeys {
  base {
    provider = "apiKey";
    mode = "self";
    audience = "workforce";
    apiKey {
      header = "X-Device-Key";
      store = "iot.TelemetryService";
      storeBlock = "alertDb";
      entity = "ApiKey";
      fields {
        hash = "keyHash";
        owner = "ownerId";
        scopes = "scopes";
        active = "isActive";
        expiresAt = "expiresAt";
        lastUsedAt = "lastUsedAt";
      }
      lastUsedResolutionSeconds = 60;
      serviceProviders = ["machine"];
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
