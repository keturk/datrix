// API keys of the device command gateway. mode = self: FleetMock issues and verifies them itself, and
// only the SHA-256 hash of a key is stored.
config identity fleetKeys {
  base {
    provider = "apiKey";
    mode = "self";
    audience = "workforce";
    apiKey {
      header = "X-Fleet-Api-Key";
      store = "iot.FleetMock";
      storeBlock = "fleetDb";
      entity = "ApiKey";
      fields {
        hash = "keyHash";
        owner = "ownerId";
        scopes = "scopes";
        active = "isActive";
        expiresAt = "expiresAt";
        lastUsedAt = "lastUsedAt";
      }
      lastUsedResolutionSeconds = 60;
      serviceProviders = ["machine"];
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
