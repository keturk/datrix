// What the Coldframe apps share: the brand and the shape of a page.
module iot.ui {

    theme Brand {
        color primary      = '#0b5e8a';
        color onPrimary    = '#ffffff';
        color surface      = '#ffffff';
        color onSurface    = '#11262f';
        color background   = '#f1f7fa';
        color onBackground = '#11262f';
        color success      = '#166534';
        color onSuccess    = '#ffffff';
        color warning      = '#854d0e';
        color onWarning    = '#ffffff';
        color info         = '#1e40af';
        color onInfo       = '#ffffff';
        color danger       = '#991b1b';
        color onDanger     = '#ffffff';
        color neutral      = '#52646d';
        color onNeutral    = '#ffffff';
        space sm           = 8;
        space md           = 16;
        space lg           = 24;
        radius card        = 12;
        font body          = font('Inter', 16, 400);
        font heading       = font('Inter', 24, 700);
        breakpoint md      = 768;
        breakpoint lg      = 1024;
        scheme dark {
            color surface      = '#1a2c35';
            color onSurface    = '#e3eff4';
            color background   = '#101d23';
            color onBackground = '#e3eff4';
            color primary      = '#7cc7ec';
            color onPrimary    = '#04344f';
        }
    }

    /// Figures across the top of a dashboard.
    style statRow {
        columns: 2;
        gap: space.md;
        at (md) { columns: 4; }
    }
}
