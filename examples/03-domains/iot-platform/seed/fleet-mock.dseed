// The simulated devices, one for each serial number in seed/device-service.dseed, and the key the
// firmware service presents to the gateway. The key itself is the development default of the service's
// secret; the gateway stores only its SHA-256 hash. CF-2002 refuses firmware updates, so a rollout shows
// what a refusal looks like.
seed service iot.FleetMock {
  rdbms fleetDb {
    baseline {
      ApiKey table on(keyHash) {
        id,                keyHash,                                                            ownerId,                 scopes,             isActive;
        @uuid("fleet-key"), "c96a0ca184beee2cfe98bb96a466e2a523ec98677f69a5daf88a5a66d9c50181", @uuid("owner-coldframe"), ["commands:write"], true;
      }
      SimulatedDevice table on(serialNumber) {
        id,                serialNumber, name,              normalTemperature, refusesUpdates, firmwareVersion;
        @uuid("sim-dairy"), "CF-1001",    "Dairy fridge",    3.0,               false,          "1.4.0";
        @uuid("sim-meat"),  "CF-1002",    "Meat cold room",  2.0,               false,          "1.4.0";
        @uuid("sim-ice"),   "CF-2001",    "Ice cream chest", -18.0,             false,          "1.4.0";
        @uuid("sim-veg"),   "CF-2002",    "Vegetable room",  5.0,               true,           "1.3.2";
      }
    }
  }
}
