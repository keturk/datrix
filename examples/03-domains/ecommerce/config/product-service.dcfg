config service ecommerce.ProductService {
  template standardCachePolicy() {
    availability = "required";
    health = "ready";
    operations {
      read       { onFailure = "raise"; }
      write      { onFailure = "raise"; }
      invalidate { onFailure = "warn"; }
    }
  }

  base {
    port = 8004;
    flavor = "compose";
    replicas = 1;
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms productDb {
      id = "da28fb93-1f04-48b2-a267-bb670d3a54b1";
      engine = "postgres";
      flavor = "container";
      host = "localhost";
      port = 5432;
      database = "library_books";
      poolSize = 20;
      maxOverflow = 20;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
      dockerImage = "postgres:17-alpine";
      volumePath = "/var/lib/postgresql/data";
      defaultUser = "postgres";
    }
    cache redis {
      engine = "redis";
      flavor = "container";
      host = "localhost";
      port = 6379;
      dockerImage = "redis:7";
      volumePath = "/data";
      healthCheckCmd = "redis-cli ping";
    }
    pubsub mq {
      engine = "kafka";
      flavor = "container";
      brokers = ["localhost:9092"];
      partitions = 3;
      replicationFactor = 1;
      port = 9092;
      dockerImage = "confluentinc/cp-kafka:7.6.0";
      volumePath = "/var/lib/kafka/data";
      retention = "7d";
      controllerPort = 9093;
    }
    nosql docdb {
      engine = "mongodb";
      flavor = "container";
      host = "localhost";
      database = "product_analytics";
      port = 27017;
      dockerImage = "mongo:7";
      volumePath = "/data/db";
      healthCheckCmd = "mongosh --eval 'db.adminCommand({ ping: 1 })'";
    }
    storage store {
      provider = "minio";
      flavor = "minio";
      bucket = "product-images";
      endpoint = "http://localhost:9000";
      region = "us-east-1";
    }
    jobs {
      jobs {
        ReleaseExpiredReservations {
          schedule = "*/5 * * * *";
          timeout = 60s;
        }
        UpdatePopularProducts {
          schedule = "0 * * * *";
          timeout = 120s;
        }
      }
    }
    registration {
      tags = ["api", "library", "v1"];
      meta = {};
      healthCheck {
        type = "http";
        path = "/health";
        interval = "10s";
      }
    }
    resilience {
      defaults {
        timeout = "10s";
        retry {
          maxAttempts = 2;
          backoff {
            type = "exponential";
            initial = "100ms";
            multiplier = 2;
          }
        }
      }
      dependencyPolicy {
        defaults {
          cache from standardCachePolicy();
        }
      }
    }
    httpSecurity {
      allowedHosts = ["product-service.example.com", "localhost"];
      corsOrigins = ["https://app.example.com"];
      corsMethods = ["GET", "POST", "PATCH", "DELETE", "OPTIONS"];
      corsHeaders = ["Authorization", "Content-Type"];
    }
    cacheOps {
      ttlSeconds = 300;
      keyMaxLength = 100;
      redisPoolSize = 10;
    }
    queueOps {
      sqsPollWaitSeconds = 20;
      sqsMaxMessagesPerPoll = 10;
      servicebusMaxWaitSeconds = 5;
    }
    kafkaOps {
      consumerPollTimeoutMs = 1000;
      keepalivePollTimeoutMs = 1000;
      maxPollIntervalMs = 600000;
    }
    messagingOps {
      rabbitmqPrefetchCount = 10;
    }
    downloadOps {
      timeoutSeconds = 300;
      chunkSizeBytes = 65536;
      maxRetries = 3;
      retryDelaySeconds = 1.0;
      retryableStatusCodes = [429, 500, 502, 503, 504];
    }
    remoteConfigOps {
      consulTimeoutSeconds = 5.0;
      appconfigMinPollSeconds = 15;
    }
    rateLimitOps {
      windowSeconds = 60;
    }
    microserviceClientOps {
      timeoutSeconds = 300;
      circuitBreakerFailMax = 5;
      circuitBreakerResetSeconds = 30;
      bulkheadMaxConcurrent = 10;
      integrationConnectTimeoutMs = 1000;
      integrationReadTimeoutMs = 30000;
      mailgunTimeoutSeconds = 30;
    }
    retryBudgetOps {
      window = 100;
      ratio = 0.1;
    }
    outboxOps {
      flushBatchSize = 500;
    }
    serviceCredentialOps {
      tokenExpirySkewSeconds = 30;
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";

    flavor = "ecs-fargate";
    replicas = 2;
    replace rdbms productDb {
      id = "da28fb93-1f04-48b2-a267-bb670d3a54b1";
      engine = "postgres";
      flavor = "rds";
      host = "postgres.internal";
      database = "library_books";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms productDb {
      id = "da28fb93-1f04-48b2-a267-bb670d3a54b1";
      engine = "postgres";
      flavor = "rds";
      port = 5432;
      database = "library_books";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      instanceClass = "db.t3.medium";
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    replace cache redis {
      engine = "redis";
      flavor = "elasticache";
      port = 6379;
      nodeType = "cache.t3.small";
    }
    replace pubsub mq {
      engine = "kafka";
      flavor = "msk";
      instanceType = "kafka.m5.large";
      brokerCount = 3;
      storageGb = 100;
      kafkaVersion = "3.6.0";
      partitions = 3;
      replicationFactor = 3;
      retention = "7d";
    }
    replace nosql docdb {
      engine = "mongodb";
      flavor = "documentdb";
      database = "product_analytics";
      port = 27017;
      instanceClass = "db.t3.medium";
      instanceCount = 2;
      engineVersion = "5.0.0";
    }
    replace storage store {
      provider = "s3";
      flavor = "s3";
      bucket = "product-images";
      region = "us-east-1";
      credentials = "iam";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile azure as "azure" extends base {
    alias env = "AZURE";
    alias resource = "azure";

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms productDb {
      id = "da28fb93-1f04-48b2-a267-bb670d3a54b1";
      engine = "postgres";
      flavor = "flexible-server";
      port = 5432;
      database = "library_books";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      sku = "Standard_B1ms";
      tier = "Burstable";
      storageGb = 32;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    replace cache redis {
      engine = "redis";
      flavor = "cache-for-redis";
      sku = "Balanced_B0";
    }
    replace pubsub mq {
      engine = "kafka";
      flavor = "event-hubs";
      sku = "Standard";
      namespaceGroup = "ecommerce-events";
      partitions = 3;
      replicationFactor = 3;
      retention = "7d";
    }
    replace nosql docdb {
      engine = "mongodb";
      flavor = "cosmos-db";
      database = "product_analytics";
      // Reviews and browsing analytics are read per product, so the product
      // id is the shard key on every collection in this block.
      partitionKey = "productId";
    }
    replace storage store {
      provider = "azure_blob";
      flavor = "blob-storage";
      container = "product-images";
      credentials = "managed-identity";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile azureVm as "azvm" extends base {
    alias env = "AZVM";
    alias resource = "azvm";

    replace rdbms productDb {
      id = "da28fb93-1f04-48b2-a267-bb670d3a54b1";
      engine = "postgres";
      flavor = "flexible-server";
      port = 5432;
      database = "library_books";
      poolSize = 20;
      maxOverflow = 20;
      ssl = true;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    replace storage store {
      provider = "azure_blob";
      flavor = "blob-storage";
      container = "product-images";
      credentials = "managed-identity";
    }
  }
}
