config service ecommerce.NotificationService {
  base {
    port = 8001;
    flavor = "compose";
    replicas = 1;
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms notificationDb {
      id = "64704790-5f82-4b4e-8d2b-0dbc989dfd3f";
      engine = "postgres";
      flavor = "container";
      host = "localhost";
      port = 5432;
      database = "notification_db";
      poolSize = 20;
      maxOverflow = 20;
      ssl = false;
      healthCheckSql = "SELECT 1";
      dockerImage = "postgres:17-alpine";
      volumePath = "/var/lib/postgresql/data";
      defaultUser = "postgres";
    }
    registration {
      tags = ["api", "shop", "v1"];
      meta = {};
      healthCheck {
        type = "http";
        path = "/health";
        interval = "10s";
      }
    }
    resilience {
      defaults {
        timeout = "10s";
        retry {
          maxAttempts = 2;
          backoff {
            type = "exponential";
            initial = "100ms";
            multiplier = 2;
          }
        }
      }
    }
    // The default exists only on a local stack, where it matches the hash seeded in seed/email-mock.dseed.
    // Any other deployment must supply the handle's value.
    secrets {
      secret email_provider_api_key {
        required = true;
        purpose = "API key for the email vendor (EmailProvider contract).";
        localDefault = "dev-only-email-key-not-a-credential";
      }
    }
    httpSecurity {
      allowedHosts = ["ecommerce-notification-service", "localhost"];
      corsOrigins = ["http://localhost:4200", "http://localhost:4300", "http://localhost:4500"];
      corsMethods = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"];
      corsHeaders = ["Authorization", "Content-Type"];
    }
    cacheOps {
      ttlSeconds = 300;
      keyMaxLength = 100;
      redisPoolSize = 10;
    }
    queueOps {
      sqsPollWaitSeconds = 20;
      sqsMaxMessagesPerPoll = 10;
      servicebusMaxWaitSeconds = 5;
    }
    kafkaOps {
      consumerPollTimeoutMs = 1000;
      keepalivePollTimeoutMs = 1000;
      maxPollIntervalMs = 600000;
    }
    messagingOps {
      rabbitmqPrefetchCount = 10;
    }
    downloadOps {
      timeoutSeconds = 300;
      chunkSizeBytes = 65536;
      maxRetries = 3;
      retryDelaySeconds = 1.0;
      retryableStatusCodes = [429, 500, 502, 503, 504];
    }
    remoteConfigOps {
      consulTimeoutSeconds = 5.0;
      appconfigMinPollSeconds = 15;
    }
    rateLimitOps {
      windowSeconds = 60;
    }
    microserviceClientOps {
      timeoutSeconds = 300;
      circuitBreakerFailMax = 5;
      circuitBreakerResetSeconds = 30;
      bulkheadMaxConcurrent = 10;
      integrationConnectTimeoutMs = 1000;
      integrationReadTimeoutMs = 30000;
      mailgunTimeoutSeconds = 30;
    }
    retryBudgetOps {
      window = 100;
      ratio = 0.1;
    }
    outboxOps {
      flushBatchSize = 500;
    }
    serviceCredentialOps {
      tokenExpirySkewSeconds = 30;
    }
    integrations {
      push {
        provider = "fcm";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";

    replicas = 2;
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    // Consumers run as SQS-triggered Lambdas: the `mq` topics this service reads
    // cross service boundaries, which on AWS means SNS/SQS, and no language
    // target runs an SQS pubsub consumer inside the service process.
    runtime { consumers = "decoupled"; }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms notificationDb {
      id = "64704790-5f82-4b4e-8d2b-0dbc989dfd3f";
      engine = "postgres";
      flavor = "rds";
      port = 5432;
      database = "notification_db";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      instanceClass = "db.t3.medium";
      healthCheckSql = "SELECT 1";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile azure as "azure" extends base {
    alias env = "AZURE";
    alias resource = "azure";

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms notificationDb {
      id = "64704790-5f82-4b4e-8d2b-0dbc989dfd3f";
      engine = "postgres";
      flavor = "flexible-server";
      port = 5432;
      database = "notification_db";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      sku = "Standard_B1ms";
      tier = "Burstable";
      storageGb = 32;
      healthCheckSql = "SELECT 1";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile azureVm as "azvm" extends base {
    alias env = "AZVM";
    alias resource = "azvm";

    replace rdbms notificationDb {
      id = "64704790-5f82-4b4e-8d2b-0dbc989dfd3f";
      engine = "postgres";
      flavor = "flexible-server";
      port = 5432;
      database = "notification_db";
      poolSize = 20;
      maxOverflow = 20;
      ssl = true;
      healthCheckSql = "SELECT 1";
    }
  }
}
