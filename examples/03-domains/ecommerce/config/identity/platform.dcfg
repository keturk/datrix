// Platform-managed identity provider for 'platform'.
// mode = platformManaged: the generator resolves the target-native provider at
// generation time (docker → Keycloak, Azure → Entra, AWS → Cognito).
config identity platform {
  base {
    audience = "machine";
    mode = "platformManaged";
    jwksCacheTtlSeconds = 3600;
  }

  profile development as "dev" extends base {
  }

  profile test as "test" extends base {
  }

  profile staging as "stg" extends base {
  }

  profile production as "prod" extends base {
  }

  // AWS provisions exactly one Cognito User Pool per application, and the
  // customer-facing 'identity' provider owns it. The machine-to-machine
  // provider is therefore validated against an operator-managed OIDC issuer
  // on this target rather than provisioned.
  profile aws as "aws" extends base {
    mode = "external";
    provider = "external";
    issuer = "https://machine-auth.ecommerce.example.com";
    clientId = "ecommerce-service-clients";
    clientSecret = "platform_identity_client_secret";
  }

  profile azure as "azure" extends base {
  }

  profile azureVm as "azvm" extends base {
  }
}
