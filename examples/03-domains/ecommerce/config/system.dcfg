config system library.System {
  base {
    migrations {
      // `false` is for projects that are generated fresh and never deployed,
      // where a tracked migration lifecycle is meaningless. This example is
      // deployed: the wire-shape round-trip gate boots its emitted stack and
      // calls the generated browser client against it. Without a migration
      // lifecycle the deployment comes up against a database holding the
      // enum types and not one table, and every read answers 500.
      enabled = true;
    }
    deployment {
      runtime = "docker-compose";
      provider = "local";
    }
    defaultTimeout = 30000;
    maxPageSize = 100;
    platforms {
      docker {
        kafka_default_retention_ms = 604800000;
        infra {
          defaultHealthcheck {
            interval = "10s";
            timeout = "10s";
            retries = 10;
            startPeriod = "30s";
          }
          elasticsearchHealthcheck {
            interval = "10s";
            timeout = "5s";
            retries = 5;
            startPeriod = "30s";
          }
          rabbitmqHealthcheck {
            interval = "10s";
            timeout = "15s";
            retries = 20;
            startPeriod = "60s";
          }
          kafkaHealthcheck {
            interval = "10s";
            timeout = "15s";
            retries = 20;
            startPeriod = "60s";
          }
          jobWorkerHealthcheck {
            interval = "30s";
            timeout = "10s";
            retries = 3;
            startPeriod = "40s";
          }
          observabilityHealthcheck {
            interval = "15s";
            timeout = "10s";
            retries = 5;
            startPeriod = "30s";
          }
          pgbouncer {
            maxClientConn = 200;
            defaultPoolSize = 20;
          }
          elasticsearch {
            heap = "512m";
          }
          initScript {
            maxRetries = 30;
            retryDelaySeconds = 2;
          }
          multiRdbmsStartPeriodSeconds = 120;
          // Desktop Docker hosts mount `/` privately, so the container-metrics
          // collector's host-tree binds are refused and the whole stack fails to
          // start. This example is documentation people run, most of them on such a
          // host, so it declares the host it targets rather than the Linux default.
          // A product deploying to a Linux host omits this and keeps the binds.
          sharedMountPropagation = false;
        }
      }
    }
    gateway {
      rateLimit {
        default {
          requests = 100;
          window = "1m";
          key = "ip";
        }
      }
      auth {
        jwt {
          algorithm = "RS256";
          issuer = "library";
          expiresIn = 86400;
        }
      }
      cors {
        origins = ["http://localhost:3000"];
        methods = ["GET", "POST", "PUT", "DELETE", "PATCH"];
        headers = ["Content-Type", "Authorization"];
      }
    }
    observability {
      metrics {
        provider = "prometheus";
        endpoint = "/metrics";
        includeDefault = true;
      }
      tracing {
        provider = "jaeger";
        samplingRate = 0.1;
      }
      logging {
        level = "info";
        format = "json";
        provider = "loki";
      }
      visualization {
        provider = "grafana";
      }
      alerting {
        provider = "alertmanager";
      }
    }
    zitadelIdentity {
      host = "zitadel";
      port = 8080;
      externalDomain = "localhost";
      externalSecure = false;
      adminUser = "admin";
      adminPassword = "identity_zitadel_admin_password";
      masterKey = "identity_zitadel_master_key";
      providers {
        identity {
          project = "library-identity";
          clientId = "library-identity-app";
        }
        platform {
          project = "library-platform";
          clientId = "library-platform-app";
        }
      }
    }
    configStore {
      engine = "file";
      flavor = "container";
      applicationName = "library-system";
      environment = "dev";
      profiles {
        settings {
          kind = "freeform";
          keys {
            Boolean debugMode : description("Enable debug mode.") = false;
          }
        }
      }
    }
    clients {
      angular {
        packageScope = "@ecommerce";
        baseUrlToken = "ECOMMERCE_API_BASE_URL";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";

    deployment {
      runtime = "docker-compose";
      provider = "local";
    }
    gateway {
      cors {
        origins = ["https://library.example.com"];
      }
    }
    observability {
      tracing {
        endpoint = "http://jaeger:4317";
      }
    }
    region = "us-east-1";
  }
}
