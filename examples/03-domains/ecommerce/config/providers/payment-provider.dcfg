// Where the PaymentProvider contract is served. Every profile here points at the mock in the same stack;
// pointing one at a real vendor changes only this file.
config extern ecommerce.PaymentProvider {
  base {
    deployment = "external";
    url = "http://ecommerce-payment-mock:8090";
    auth {
      type = "apiKey";
      header = "X-Payment-Api-Key";
      // A logical handle; the consuming service declares it and its value is never in a file here.
      secret = "payment_provider_api_key";
    }
    timeout = "10s";
    retry {
      maxAttempts = 3;
      backoff = "exponential";
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }

  profile aws as "aws" extends base {
  }

  profile azure as "azure" extends base {
  }

  profile azureVm as "azvm" extends base {
  }
}
