config app ecommerce.Site {
  base {
    targets = ["angular"];
    strings = ["config/strings/site.en-US.dcfg", "config/strings/site.tr-TR.dcfg"];
  }
  // Loopback profiles are never indexed: `indexable` defaults to false, so a local or test
  // site says `noindex` and ships `Disallow: /`.
  profile development as "dev" extends base {
    web { port = 4400; }
  }
  profile test as "test" extends base {
    web { port = 4400; }
  }
  profile production as "prod" extends base {
    web { port = 4400; }
  }
  // Deployed profiles name the site's origin and say it may be indexed: the build writes
  // `sitemap.xml` and every canonical and alternate-language link from this origin.
  profile aws extends base {
    web {
      domain { name = "www.library.example.com"; }
      indexable = true;
    }
  }
  profile azure extends base {
    web {
      domain { name = "www.library.example.com"; }
      indexable = true;
    }
  }
  profile azureVm extends base {
    web {
      domain { name = "www.library.example.com"; }
      indexable = true;
    }
  }
}
