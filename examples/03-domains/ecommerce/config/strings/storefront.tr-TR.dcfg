    field.Order.updatedAt                    = "Güncellenme";
    enum.OrderStatus.Pending                 = "Beklemede";
    enum.OrderStatus.PaymentPending          = "Ödeme bekleniyor";
    enum.OrderStatus.Confirmed               = "Onaylandı";
    enum.OrderStatus.Processing              = "Hazırlanıyor";
    enum.OrderStatus.Shipped                 = "Kargoya verildi";
    enum.OrderStatus.Delivered               = "Teslim edildi";
