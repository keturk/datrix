    framework.failed       = "Bir şeyler ters gitti";
    framework.submit       = "Gönder";
    framework.required     = "Bu alan zorunludur";
    framework.tooShort     = "En az {min} karakter girin";
    framework.tooLong      = "En fazla {max} karakter girin";
    framework.invalid      = "Geçerli bir değer girin";
    framework.next         = "Sonraki";
    framework.previous     = "Önceki";
    framework.add          = "Ekle";
    framework.remove       = "Kaldır";
    framework.dismiss      = "Kapat";
    framework.menu         = "Menü";
    framework.formatting   = "Biçimlendirme";
