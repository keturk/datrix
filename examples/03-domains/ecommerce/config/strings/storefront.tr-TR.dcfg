    framework.today        = "Bugün";
    framework.month        = "Ay";
    framework.week         = "Hafta";
    framework.day          = "Gün";
  }
  // The default locale falls back to humanized names; every other locale
  // names every page, field, enum member, action, step, empty state and error
  // the app shows.
  labels {
    app.Storefront                           = "Mağaza";
    page.Home                               = "Ana sayfa";
    page.ProductList                         = "Ürünler";
    page.ProductDetail                       = "Ürün";
    page.Cart                                = "Sepet";
    page.OrderList                           = "Siparişlerim";
    page.NewOrder                            = "Yeni sipariş";
    page.OrderDetail                         = "Sipariş";
    page.NotFound                            = "Sayfa bulunamadı";

    action.Catalog.open                      = "Aç";
    action.Orders.open                       = "Aç";
    empty.Catalog                            = "Henüz ürün yok";
    empty.Orders                             = "Henüz siparişiniz yok";
    step.CreateOrder.items                   = "Ürünler";
    step.CreateOrder.shipping                = "Teslimat";

    field.Product.id                         = "Kimlik";
