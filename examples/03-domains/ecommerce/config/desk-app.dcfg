config app ecommerce.ProviderDesk {
  base {
    targets = ["angular"];
    strings = ["config/strings/desk.en-US.dcfg"];
    clients {
      angular {
        scope = "@ecommerce";
      }
    }
  }
  profile development as "dev" extends base {
    web { port = 4500; }
  }
  profile test as "test" extends base {
    web { port = 4500; }
  }
  profile production as "prod" extends base {
    web { port = 4500; }
  }
  profile aws extends base {
    web { domain { name = "vendors.wrenwood.example.com"; } }
  }
  profile azure extends base {
    web { domain { name = "vendors.wrenwood.example.com"; } }
  }
  profile azureVm extends base {
    web { domain { name = "vendors.wrenwood.example.com"; } }
  }
}
