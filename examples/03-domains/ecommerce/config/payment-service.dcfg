config service ecommerce.PaymentService {
  base {
    port = 8003;
    flavor = "compose";
    replicas = 1;
    resources {
      requests {
        cpu = "100m";
        memory = "256Mi";
      }
      limits {
        cpu = "500m";
        memory = "512Mi";
      }
    }
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms paymentDb {
      id = "5e69f2e0-30ab-47c0-b98b-fdc4c8ddc711";
      engine = "postgres";
      flavor = "container";
      host = "localhost";
      port = 5432;
      database = "library_books";
      poolSize = 20;
      maxOverflow = 20;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
      dockerImage = "postgres:17-alpine";
      volumePath = "/var/lib/postgresql/data";
      defaultUser = "postgres";
    }
    pubsub mq {
      engine = "kafka";
      flavor = "container";
      brokers = ["localhost:9092"];
      partitions = 3;
      replicationFactor = 1;
      port = 9092;
      dockerImage = "confluentinc/cp-kafka:7.6.0";
      volumePath = "/var/lib/kafka/data";
      retention = "7d";
      controllerPort = 9093;
    }
    registration {
      tags = ["api", "library", "v1"];
      meta = {};
      healthCheck {
        type = "http";
        path = "/health";
        interval = "10s";
      }
    }
    resilience {
      defaults {
        timeout = "10s";
        retry {
          maxAttempts = 2;
          backoff {
            type = "exponential";
            initial = "100ms";
            multiplier = 2;
          }
        }
      }
      dependencyPolicy {
        defaults {
          service {
            availability = "required";
            health = "ready";
          }
        }
      }
    }
    // Operator-provisioned handles: each is mounted as a compose file secret
    // and the deploy script refuses to start while its file is absent. The
    // localDefault is a throwaway dev seed written on local profiles only
    // (development, test); on every other profile the operator writes the
    // real value to secrets/<service>/<handle> before deploying.
    secrets {
      secret stripe_secret_key {
        required = true;
        purpose = "Stripe secret API key for payment processing.";
        localDefault = "dev-only-stripe-secret-key-not-a-credential";
      }
      secret payment_webhook_secret {
        required = true;
        purpose = "Signing key for inbound payment-gateway webhook signature verification.";
        localDefault = "dev-only-payment-webhook-signing-key-not-a-credential";
      }
    }
    integrations {
      payment {
        provider = "stripe";
        currency = "USD";
        testMode = false;
      }
    }
    httpSecurity {
      allowedHosts = ["payment-service.example.com", "localhost"];
      corsOrigins = ["https://app.example.com"];
      corsMethods = ["GET", "POST", "PATCH", "DELETE", "OPTIONS"];
      corsHeaders = ["Authorization", "Content-Type"];
    }
    cacheOps {
      ttlSeconds = 300;
      keyMaxLength = 100;
      redisPoolSize = 10;
    }
    queueOps {
      sqsPollWaitSeconds = 20;
      sqsMaxMessagesPerPoll = 10;
      servicebusMaxWaitSeconds = 5;
    }
    kafkaOps {
      consumerPollTimeoutMs = 1000;
      keepalivePollTimeoutMs = 1000;
      maxPollIntervalMs = 600000;
    }
    messagingOps {
      rabbitmqPrefetchCount = 10;
    }
    downloadOps {
      timeoutSeconds = 300;
      chunkSizeBytes = 65536;
      maxRetries = 3;
      retryDelaySeconds = 1.0;
      retryableStatusCodes = [429, 500, 502, 503, 504];
    }
    remoteConfigOps {
      consulTimeoutSeconds = 5.0;
      appconfigMinPollSeconds = 15;
    }
    rateLimitOps {
      windowSeconds = 60;
    }
    microserviceClientOps {
      timeoutSeconds = 300;
      circuitBreakerFailMax = 5;
      circuitBreakerResetSeconds = 30;
      bulkheadMaxConcurrent = 10;
      integrationConnectTimeoutMs = 1000;
      integrationReadTimeoutMs = 30000;
      mailgunTimeoutSeconds = 30;
    }
    retryBudgetOps {
      window = 100;
      ratio = 0.1;
    }
    outboxOps {
      flushBatchSize = 500;
    }
    serviceCredentialOps {
      tokenExpirySkewSeconds = 30;
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";

    flavor = "ecs-fargate";
    replicas = 2;
    replace rdbms paymentDb {
      id = "5e69f2e0-30ab-47c0-b98b-fdc4c8ddc711";
      engine = "postgres";
      flavor = "rds";
      host = "postgres.internal";
      database = "library_books";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile aws as "aws" extends base {
    alias env = "AWS";
    alias resource = "aws";

    // Consumers run inside the ECS task, not as SQS-triggered Lambdas: the
    // Lambda packaging path is realized for python and typescript only, and
    // this example generates in every registered language.
    runtime { consumers = "in-process"; }

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms paymentDb {
      id = "5e69f2e0-30ab-47c0-b98b-fdc4c8ddc711";
      engine = "postgres";
      flavor = "rds";
      port = 5432;
      database = "library_books";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      instanceClass = "db.t3.medium";
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    replace pubsub mq {
      engine = "kafka";
      flavor = "msk";
      instanceType = "kafka.m5.large";
      brokerCount = 3;
      storageGb = 100;
      kafkaVersion = "3.6.0";
      partitions = 3;
      replicationFactor = 3;
      retention = "7d";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile azure as "azure" extends base {
    alias env = "AZURE";
    alias resource = "azure";

    replicas = 2;
    scaling {
      replicas {
        min = 2;
        max = 4;
      }
      triggers = [];
    }
    replace rdbms paymentDb {
      id = "5e69f2e0-30ab-47c0-b98b-fdc4c8ddc711";
      engine = "postgres";
      flavor = "flexible-server";
      port = 5432;
      database = "library_books";
      poolSize = 40;
      maxOverflow = 20;
      ssl = true;
      sku = "Standard_B1ms";
      tier = "Burstable";
      storageGb = 32;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
    replace pubsub mq {
      engine = "kafka";
      flavor = "event-hubs";
      sku = "Standard";
      namespaceGroup = "ecommerce-events";
      partitions = 3;
      replicationFactor = 3;
      retention = "7d";
    }
    strategy {
      rolling {
        maxUnavailable = "25%";
      }
    }
  }

  profile azureVm as "azvm" extends base {
    alias env = "AZVM";
    alias resource = "azvm";

    replace rdbms paymentDb {
      id = "5e69f2e0-30ab-47c0-b98b-fdc4c8ddc711";
      engine = "postgres";
      flavor = "flexible-server";
      port = 5432;
      database = "library_books";
      poolSize = 20;
      maxOverflow = 20;
      ssl = true;
      asyncDriver = "postgresql+asyncpg";
      syncDriver = "postgresql+psycopg2";
      healthCheckSql = "SELECT 1";
    }
  }
}
