// The key the shipping service presents to the carrier. The key itself is the development default of the
// service's secret; the vendor stores only its SHA-256 hash.
seed service ecommerce.CarrierMock {
  rdbms carrierDb {
    baseline {
      ApiKey table on(keyHash) {
        id,                   keyHash,                                                            ownerId,                scopes,                  isActive;
        @uuid("carrier-key"), "abcf36cdcc8dbfedb44b1023455ce43d3a61e69d6a20bb09c7ebc6c19430be9e", @uuid("owner-wrenwood"), ["consignments:write"], true;
      }
    }
  }
}
