from ecommerce.common import generateTransactionId;

// Takes the money. OrderService queues a charge; this service asks the card vendor through the PaymentProvider
// contract and announces the outcome, which is what moves the order on. Cancelling a paid order comes back here
// as an event and refunds it, with no call between the two services.
service ecommerce.PaymentService('config/payment-service.dcfg') : version('2.0.0'), description('Charges, refunds and settlement') {

    // Its queues and its events come from OrderService; there is no direct call in either direction.
    discovery {
        ecommerce.OrderService { loadBalance: roundRobin, healthyOnly: true }
    }

    uses ecommerce.PaymentProvider;

    exceptions {
        NotYourPaymentError : status(404), message("There is no such payment");
        CannotRefundError : status(409), message("That payment cannot be refunded");
        RefundTooLargeError : status(422), message("That is more than is left to refund");
    }

    enum PaymentStatus {
        Pending : tone(neutral),
        Processing : tone(info),
        Completed : tone(success),
        Failed : tone(danger),
        Refunded : tone(warning)
    }

    struct RefundPaymentRequest {
        UUID paymentId;
        Money amount;
        String(500) reason;
    }

    struct PaymentSummary {
        Money takenToday;
        Money takenThisWeek;
        Int failedThisWeek;
        Money refundedThisWeek;
    }

    // ': audit' on the rdbms block records every change to every entity in it.
    rdbms paymentDb : audit {
        alert queryDuration(avg) over(5m) > 200ms @severity(warning);
        alert transactionDuration(max) over(1m) > 2s @severity(critical);

        entity Payment extends BaseEntity {
            UUID orderId : index;
            String(30) orderNumber : filterable;
            String(64) customerId : index;
            Money amount;
            String(3) currency = "USD";
            PaymentStatus status : filterable = PaymentStatus.Pending;
            String(100) transactionId : unique;

            String(40)? providerChargeId;
            String(200)? errorMessage;
            DateTime? processedAt;

            Boolean isSuccessful := status == PaymentStatus.Completed;
            Boolean canRefund := status == PaymentStatus.Completed;

            hasMany Refund as refunds;

            index(customerId, status);

            // One event per outcome: every other service learns about money from these.
            afterUpdate {
                if (isChanged(status)) {
                    if (status == PaymentStatus.Completed) {
                        dispatch PaymentProcessed(id, orderId, amount);
                    } else if (status == PaymentStatus.Failed) {
                        dispatch PaymentFailed(id, orderId, errorMessage ?? "Payment failed");
                    } else if (status == PaymentStatus.Refunded) {
                        dispatch PaymentRefunded(id, orderId, amount);
                    }
                }
            }
        }

        entity Refund extends BaseEntity {
            Money amount;
            String(500) reason;
            String(120) requestedBy;

            belongsTo Payment : index;
        }

        /// What this shop's books owe the merchant account, one row per settled payment.
        entity Settlement extends BaseEntity {
            UUID paymentId : unique;
            String(40) merchantId : filterable;
            Decimal(12, 2) amount;
            DateTime settledAt;
        }
    }

    pubsub mq {
        topic PaymentEvents {
            publish PaymentProcessed(UUID paymentId, UUID orderId, Money amount) {
                ensure amount > 0;
            }

            publish PaymentFailed(UUID paymentId, UUID orderId, String reason) {
                ensure reason.length > 0;
            }

            publish PaymentRefunded(UUID paymentId, UUID orderId, Money amount) {
                ensure amount > 0;
            }
        }
    }

    fn refund(paymentDb.Payment payment, Money amount, String reason, String requestedBy) {
        let Charge answer = PaymentProvider.PaymentAPI.post.refundCharge(RefundChargeRequest {
            chargeId: payment.providerChargeId ?? "",
            amount: amount,
            idempotencyKey: #"refund-{payment.id}-{amount.toString()}"
        });
        paymentDb.Refund.create({
            payment: payment,
            amount: amount,
            reason: reason,
            requestedBy: requestedBy
        });
        if (answer.status == ChargeStatus.Refunded) {
            payment.status = PaymentStatus.Refunded;
            payment.save();
        }
    }

    // The order was cancelled. If it had been paid for, the money goes back without anyone having to ask.
    subscribe OrderEvents {
        on OrderCancelled(UUID orderId, String reason, UUID reservationId) {
            let Payment? payment = paymentDb.Payment.where(orderId: orderId, status: PaymentStatus.Completed).first();
            if (payment != null) {
                refund(payment, payment.amount, reason, "automatic");
            }
        }
    }

    enqueue ecommerce.OrderService.ProcessPayment(UUID orderId, String orderNumber, String customerId, Money amount, String currency, String cardToken) {
        let Payment payment = paymentDb.Payment.create({
            orderId: orderId,
            orderNumber: orderNumber,
            customerId: customerId,
            amount: amount,
            currency: currency,
            transactionId: generateTransactionId(),
            status: PaymentStatus.Processing
        });
        let Charge answer = PaymentProvider.PaymentAPI.post.createCharge(CreateChargeRequest {
            cardToken: cardToken,
            amount: amount,
            currency: currency,
            reference: orderNumber,
            idempotencyKey: #"order-{orderId}"
        });
        payment.providerChargeId = answer.id;
        payment.processedAt = DateTime.now();
        if (answer.status == ChargeStatus.Succeeded) {
            payment.status = PaymentStatus.Completed;
        } else {
            payment.status = PaymentStatus.Failed;
            payment.errorMessage = answer.declineReason ?? "The card was declined";
        }
        payment.save();
    }

    // In order per merchant: the queue is FIFO on merchantId, so one account's ledger never interleaves.
    enqueue ecommerce.OrderService.SettlePayment(UUID paymentId, String merchantId, Decimal amount) {
        if (paymentDb.Settlement.where(paymentId: paymentId).first() == null) {
            paymentDb.Settlement.create({
                paymentId: paymentId,
                merchantId: merchantId,
                amount: amount,
                settledAt: DateTime.now()
            });
        }
    }

    rest_api PaymentAPI : basePath('/api/v1/payments'), rdbms(paymentDb) {
        alert responseTime(avg) over(5m) > 500ms @severity(warning);
        alert errorRate(ratio) over(5m) > 3% @severity(critical);

        // An array, because a new order has no payment for the first moments of its life.
        @path('/order/:orderId')
        get forOrder(UUID orderId) : auth(required, providers: [identity]) -> Array<paymentDb.Payment> {
            return paymentDb.Payment.where(orderId: orderId, customerId: Auth.userId()).orderBy(createdAt: desc).all();
        }
    }

    // What the Admin app shows and does.
    rest_api PaymentAdminAPI : basePath('/api/v1/admin/payments'), rdbms(paymentDb) {
        resource paymentDb.Payment : only(list, get), auth(required, providers: [identity], roles: [admin]);
        resource paymentDb.Settlement : only(list), auth(required, providers: [identity], roles: [admin]);

        @path('/summary')
        get summary() : auth(required, providers: [identity], roles: [admin]) -> PaymentSummary {
            let DateTime today = DateTime.now().startOfDay();
            let DateTime weekAgo = DateTime.now().addDays(-7);
            let Money takenToday = 0;
            foreach paid in paymentDb.Payment.where(status: PaymentStatus.Completed, createdAt: gte(today)).all() {
                takenToday = takenToday + paid.amount;
            }
            let Money takenThisWeek = 0;
            foreach paid in paymentDb.Payment.where(status: PaymentStatus.Completed, createdAt: gte(weekAgo)).all() {
                takenThisWeek = takenThisWeek + paid.amount;
            }
            let Money refundedThisWeek = 0;
            foreach given in paymentDb.Refund.where(createdAt: gte(weekAgo)).all() {
                refundedThisWeek = refundedThisWeek + given.amount;
            }
            return PaymentSummary {
                takenToday: takenToday,
                takenThisWeek: takenThisWeek,
                failedThisWeek: paymentDb.Payment.where(status: PaymentStatus.Failed, createdAt: gte(weekAgo)).count(),
                refundedThisWeek: refundedThisWeek
            };
        }

        @path('/order/:orderId')
        get forOrder(UUID orderId) : auth(required, providers: [identity], roles: [admin]) -> Array<paymentDb.Payment> {
            return paymentDb.Payment.where(orderId: orderId).orderBy(createdAt: desc).all();
        }

        @path('/refund')
        post refundPayment(RefundPaymentRequest request) : auth(required, providers: [identity], roles: [admin]) -> paymentDb.Payment {
            let Payment payment = paymentDb.Payment.findOrFail(request.paymentId);
            if (!payment.canRefund) {
                throw CannotRefundError();
            }
            let Money given = 0;
            foreach earlier in paymentDb.Refund.where(paymentId: payment.id).all() {
                given = given + earlier.amount;
            }
            if (given + request.amount > payment.amount) {
                throw RefundTooLargeError();
            }
            refund(payment, request.amount, request.reason, Auth.identity.email.toString());
            return payment;
        }
    }

    test("a completed payment can be refunded") {
        let paymentDb.Payment payment = paymentDb.Payment.create({
            orderId: uuid(),
            orderNumber: "WW-260101-000001",
            customerId: "spec-customer",
            amount: 49.99,
            transactionId: "TXN-SPEC-001",
            status: PaymentStatus.Completed
        });
        assert payment.isSuccessful == true;
        assert payment.canRefund == true;
    }

    test("completing a payment announces it") {
        let paymentDb.Payment payment = paymentDb.Payment.create({
            orderId: uuid(),
            orderNumber: "WW-260101-000002",
            customerId: "spec-customer",
            amount: 175.50,
            transactionId: "TXN-SPEC-002",
            status: PaymentStatus.Processing
        });
        payment.status = PaymentStatus.Completed;
        payment.save();
        assert emitted(PaymentProcessed(payment.id, payment.orderId, payment.amount));
    }

    test("a failed payment says why") {
        let paymentDb.Payment payment = paymentDb.Payment.create({
            orderId: uuid(),
            orderNumber: "WW-260101-000003",
            customerId: "spec-customer",
            amount: 220.00,
            transactionId: "TXN-SPEC-003",
            status: PaymentStatus.Processing,
            errorMessage: "The issuer declined this card"
        });
        payment.status = PaymentStatus.Failed;
        payment.save();
        assert emitted(PaymentFailed(payment.id, payment.orderId, "The issuer declined this card"));
    }
}
