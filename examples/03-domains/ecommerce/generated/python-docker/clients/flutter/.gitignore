# Written by the Flutter tooling, never by the generator.
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
*.iml
.idea/
# The environment's runtime config and the signing settings a build
# places in an app's project: per-environment, never committed.
/mobile/*/assets/config/runtime-config.json
/mobile/*/ios/Flutter/DatrixBuild.xcconfig
