# Datrix TypeScript Workspace - pnpm Configuration
#
# These settings apply to the entire TypeScript workspace.
# They optimize pnpm behavior for code generation use cases.

# Automatically install peer dependencies
# (Generated code may not explicitly list all peer deps)
auto-install-peers=true

# Allow peer dependency version mismatches
# (Generated code uses catalog versions which may not perfectly align)
strict-peer-dependencies=false

# Use pnpm's default isolated node_modules structure
# (Don't hoist to root - keeps dependencies properly isolated per package)
shamefully-hoist=false

# Do not run dependency lifecycle scripts for this workspace.
# This workspace exists to compile and test the generated sources; nothing it
# installs needs a build step to be imported. Leaving scripts enabled makes the
# install fail on things that have nothing to do with the generated code -- e.g.
# @nestjs/core's postinstall spawns the `opencollective` donation banner, which
# exits -4058 (ENOENT) on Windows and takes the whole install down with it.
# The runtime image is unaffected: each service's Dockerfile copies only that
# service's package.json and runs its own install, without this file.
ignore-scripts=true

# Store location for pnpm cache (relative to workspace root)
# store-dir=.pnpm-store
