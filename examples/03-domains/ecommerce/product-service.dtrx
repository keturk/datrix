from ecommerce.common import OrderLineInput, CartLine, Sluggable, Inventoried, Discountable, ProductArt;

// The catalog and its stock. Reading it needs no account. A reservation takes stock off the shelf for the few
// minutes between placing an order and paying for it, and the order's own events settle or release it. Reviews
// are documents, in a document store beside the relational catalog.
service ecommerce.ProductService('config/product-service.dcfg') : version('2.0.0'), description('Catalog, stock and reviews') {

    discovery { }

    exceptions {
        NotOnSaleError : status(404), message("That product is not on sale");
        InsufficientInventoryError : status(409), message("There is not enough of that in stock");
        BadRatingError : status(422), message("A rating is from 1 to 5 stars");
        CartTooLongError : status(422), message("A cart holds up to 50 products");
    }

    enum ProductStatus {
        Draft : tone(neutral),
        Active : tone(success),
        Discontinued : tone(warning)
    }

    enum ReservationStatus {
        Reserved : tone(info),
        Confirmed : tone(success),
        Released : tone(neutral),
        Expired : tone(warning)
    }

    /// A product as a shopper reads it.
    struct ProductCard {
        UUID id;
        String name;
        String description;
        Money price;
        Money? compareAtPrice;
        Percentage discountPercent;
        Boolean inStock;
        Int inventory;
        UUID categoryId;
        String categoryName;
        ProductArt art;
        Array<String> tags;
    }

    struct CategoryCard {
        UUID id;
        String name;
        String description;
        ProductArt art;
        Int products;
    }

    struct ReviewCard {
        String authorName;
        Int rating;
        String? title;
        String? body;
        DateTime createdAt;
    }

    struct ReviewPage {
        Int count;
        Float average;
        Array<ReviewCard> reviews;
    }

    struct AddReviewRequest {
        UUID productId;
        Int rating;
        String(200)? title;
        String(2000)? body;
    }

    struct CreateProductRequest {
        String(200) name;
        Text description;
        Money price;
        UUID categoryId;
        Int inventory = 0;
    }

    struct SetInventoryRequest {
        Int inventory;
    }

    struct ReserveInventoryRequest {
        UUID reservationId;
        Array<OrderLineInput> items;
        Int ttlSeconds = 600;
    }

    struct ReservationResponse {
        Boolean success;
        UUID? reservationId;
    }

    struct ProductFacts {
        String name;
        Money price;
    }

    struct CartCheckRequest {
        Array<CartLine> lines;
    }

    /// The cart as it stands today, and whether that differs from what the device sent.
    struct CartCheck {
        Array<CartLine> lines;
        Boolean changed;
    }

    struct CatalogSummary {
        Int onSale;
        Int outOfStock;
        Int openAlerts;
    }

    const LOW_STOCK = 5;

    rdbms productDb {

        entity Category extends BaseEntity {
            String(100) name : unique, trim;
            Text? description;
            Slug slug : unique;
            ProductArt art;

            hasMany Product as products;
        }

        // 'with' mixes traits in, adding their fields and their methods.
        entity Product extends BaseEntity with Sluggable, Discountable, Inventoried {
            String(200) name : trim, filterable;
            Text description;
            ProductStatus status : filterable = ProductStatus.Draft;
            Array<String> tags = [];
            Int viewCount = 0;

            Boolean isAvailable := status == ProductStatus.Active && hasStock();
            Percentage discountPercent := getDiscountPercent();

            belongsTo Category : index;

            index(categoryId, status);
            index(status, inventory);
            fulltext(name, description);

            afterUpdate {
                if (isChanged(inventory)) {
                    dispatch InventoryUpdated(id, oldValue(inventory), inventory);
                }
            }

            fn publish() {
                if (status == ProductStatus.Draft) {
                    status = ProductStatus.Active;
                    this.save();
                }
            }

            fn discontinue() {
                status = ProductStatus.Discontinued;
                this.save();
            }
        }

        entity InventoryReservation extends BaseEntity {
            UUID reservationId : index;
            Int quantity;
            ReservationStatus status = ReservationStatus.Reserved;
            DateTime expiresAt : index;

            belongsTo Product : index;

            index(reservationId, status);

            validate {
                if (quantity <= 0)
                ValidationError("Reservation quantity must be positive");
            }
        }

        /// A product running low, for the Admin dashboard. It closes when stock comes back.
        entity StockAlert extends BaseEntity {
            UUID productId : index;
            String(200) productName;
            Int remaining;
            Boolean isOpen = true;
        }
    }

    cache redis {
        counter ProductViews : prefix('views:product:');
    }

    pubsub mq {
        topic ProductEvents {
            publish InventoryUpdated(UUID productId, Int oldQuantity, Int newQuantity) {
                ensure newQuantity >= 0;
            }
        }
    }

    // Stock moved. Going low opens an alert, and coming back closes it.
    subscribe ProductEvents {
        on InventoryUpdated(UUID productId, Int oldQuantity, Int newQuantity) {
            let StockAlert? open = productDb.StockAlert.where(productId: productId, isOpen: true).first();
            if (newQuantity > LOW_STOCK) {
                if (open != null) {
                    open.isOpen = false;
                    open.save();
                }
            } else if (open != null) {
                open.remaining = newQuantity;
                open.save();
            } else {
                let Product product = productDb.Product.findOrFail(productId);
                productDb.StockAlert.create({ productId: productId, productName: product.name, remaining: newQuantity });
            }
        }
    }

    fn releaseReservation(UUID reservationId, ReservationStatus outcome) {
        let Array<InventoryReservation> held = productDb.InventoryReservation
            .where(reservationId: reservationId, status: ReservationStatus.Reserved)
            .all();
        transaction(productDb) {
            foreach reservation in held {
                let Product product = productDb.Product.findOrFail(reservation.productId);
                product.inventory = product.inventory + reservation.quantity;
                product.save();
                reservation.status = outcome;
                reservation.save();
            }
        }
    }

    // The order's own events settle the reservation, so nothing here calls OrderService.
    subscribe OrderEvents {
        on OrderConfirmed(UUID orderId, String customerId, String customerName, UUID? paymentId, UUID reservationId, Address shippingAddress, Array<JSON> items, Decimal estimatedWeight) {
            foreach reservation in productDb.InventoryReservation.where(reservationId: reservationId, status: ReservationStatus.Reserved).all() {
                reservation.status = ReservationStatus.Confirmed;
                reservation.save();
            }
        }

        on OrderCancelled(UUID orderId, String reason, UUID reservationId) {
            releaseReservation(reservationId, ReservationStatus.Released);
        }
    }

    // Reviews are documents.
    nosql docdb {
        entity ProductReview {
            String(40) productId : index;
            String(64) userId : index;
            String(200) authorName;
            Int rating;
            String(200)? title;
            String(2000)? body;
            DateTime createdAt;

            index(productId, createdAt);
        }
    }

    fn cardOf(productDb.Product product) -> ProductCard {
        let Category category = productDb.Category.findOrFail(product.categoryId);
        return ProductCard {
            id: product.id,
            name: product.name,
            description: product.description,
            price: product.price,
            compareAtPrice: product.compareAtPrice,
            discountPercent: product.discountPercent,
            inStock: product.isAvailable,
            inventory: product.inventory,
            categoryId: product.categoryId,
            categoryName: category.name,
            art: category.art,
            tags: product.tags
        };
    }

    fn cardsOf(Array<productDb.Product> products) -> Array<ProductCard> {
        let Array<ProductCard> cards = [];
        foreach product in products {
            cards.push(cardOf(product));
        }
        return cards;
    }

    // The public catalog: only what is on sale, and only what a shopper reads.
    rest_api CatalogAPI : basePath('/api/v1/catalog'), rdbms(productDb) {

        @path('/categories')
        get categories() : auth(public) -> Array<CategoryCard> {
            let Array<CategoryCard> cards = [];
            foreach category in productDb.Category.orderBy(name: asc).all() {
                cards.push(CategoryCard {
                    id: category.id,
                    name: category.name,
                    description: category.description ?? "",
                    art: category.art,
                    products: productDb.Product.where(categoryId: category.id, status: ProductStatus.Active).count()
                });
            }
            return cards;
        }

        @path('/products')
        get products() : auth(public) -> Array<ProductCard> {
            return cardsOf(productDb.Product.where(status: ProductStatus.Active).orderBy(name: asc).limit(60).all());
        }

        // A cart lives on the device, so it goes stale: a price moves, stock runs out, a product leaves the shop.
        // This corrects it. An order never trusts it either way, and looks every price up again.
        @path('/cart-check')
        post checkCart(CartCheckRequest request) : auth(public) -> CartCheck {
            if (request.lines.length > 50) {
                throw CartTooLongError();
            }
            let Array<CartLine> lines = [];
            let Boolean changed = false;
            foreach line in request.lines {
                let Product? product = productDb.Product.where(id: line.productId, status: ProductStatus.Active).first();
                if (product == null || product.inventory == 0) {
                    changed = true;
                } else {
                    let Int quantity = line.quantity > product.inventory ? product.inventory : line.quantity;
                    if (quantity != line.quantity || product.price != line.unitPrice || product.name != line.name) {
                        changed = true;
                    }
                    lines.push(CartLine { productId: product.id, name: product.name, unitPrice: product.price, quantity: quantity });
                }
            }
            return CartCheck { lines: lines, changed: changed };
        }

        @path('/popular')
        get popular() : auth(public) -> Array<ProductCard> {
            return cardsOf(productDb.Product.where(status: ProductStatus.Active).orderBy(viewCount: desc).limit(6).all());
        }

        @path('/search/:query')
        get search(String query) : auth(public) -> Array<ProductCard> {
            return cardsOf(productDb.Product.fulltext(query).where(status: ProductStatus.Active).limit(60).all());
        }

        @path('/category/:categoryId')
        get inCategory(UUID categoryId) : auth(public) -> Array<ProductCard> {
            return cardsOf(productDb.Product.where(categoryId: categoryId, status: ProductStatus.Active).orderBy(name: asc).all());
        }

        @path('/products/:id')
        get product(UUID id) : auth(public) -> ProductCard {
            let Product product = productDb.Product.findOrFail(id);
            if (product.status == ProductStatus.Draft) {
                throw NotOnSaleError();
            }
            redis.ProductViews.incr(id.toString());
            return cardOf(product);
        }

        @path('/products/:id/reviews')
        get reviews(UUID id) : auth(public) -> ReviewPage {
            let String productKey = id.toString();
            let Array<ProductReview> found = docdb.ProductReview.where(productId: productKey).orderBy(createdAt: desc).limit(50).all();
            let Array<ReviewCard> cards = [];
            let Int total = 0;
            foreach review in found {
                total = total + review.rating;
                cards.push(ReviewCard {
                    authorName: review.authorName,
                    rating: review.rating,
                    title: review.title,
                    body: review.body,
                    createdAt: review.createdAt
                });
            }
            return ReviewPage {
                count: found.length(),
                average: found.length() == 0 ? 0.0 : Math.round(total / found.length(), 1),
                reviews: cards
            };
        }

        @path('/reviews')
        post addReview(AddReviewRequest request) : auth(required, providers: [identity]) -> ReviewCard {
            if (request.rating < 1 || request.rating > 5) {
                throw BadRatingError();
            }
            let Product product = productDb.Product.findOrFail(request.productId);
            let DateTime now = DateTime.now();
            let String authorName = Auth.identity.fullName ?? "A customer";
            docdb.ProductReview.insert({
                productId: product.id.toString(),
                userId: Auth.userId(),
                authorName: authorName,
                rating: request.rating,
                title: request.title,
                body: request.body,
                createdAt: now
            });
            return ReviewCard {
                authorName: authorName,
                rating: request.rating,
                title: request.title,
                body: request.body,
                createdAt: now
            };
        }
    }

    // The catalog as staff work on it. The Admin app's workspace is built over this resource.
    rest_api ProductAPI : basePath('/api/v1/products'), rdbms(productDb) {

        resource productDb.Category : only(list), auth(required, providers: [identity], roles: [admin]);

        resource productDb.Product : auth(required, providers: [identity], roles: [admin]), only(list, get, update, delete);

        // Not a plain resource verb: creating a product also makes its slug and announces it.
        post createProduct(CreateProductRequest request) : auth(required, providers: [identity], roles: [admin]) -> productDb.Product {
            let Product product = productDb.Product.create({
                name: request.name,
                description: request.description,
                price: request.price,
                categoryId: request.categoryId,
                inventory: request.inventory,
                status: ProductStatus.Draft
            });
            product.generateSlug(request.name);
            product.save();
            return product;
        }

        @path('/:id/inventory')
        post setInventory(UUID id, SetInventoryRequest request) : auth(required, providers: [identity], roles: [admin]) -> productDb.Product {
            let Product product = productDb.Product.findOrFail(id);
            product.inventory = request.inventory;
            product.save();
            return product;
        }

        @path('/:id/publish')
        post publishProduct(UUID id) : auth(required, providers: [identity], roles: [admin]) -> productDb.Product {
            let Product product = productDb.Product.findOrFail(id);
            product.publish();
            return product;
        }

        @path('/:id/discontinue')
        post discontinueProduct(UUID id) : auth(required, providers: [identity], roles: [admin]) -> productDb.Product {
            let Product product = productDb.Product.findOrFail(id);
            product.discontinue();
            return product;
        }

        @path('/alerts')
        get openAlerts() : auth(required, providers: [identity], roles: [admin]) -> Array<productDb.StockAlert> {
            return productDb.StockAlert.where(isOpen: true).orderBy(remaining: asc).all();
        }

        @path('/summary')
        get summary() : auth(required, providers: [identity], roles: [admin]) -> CatalogSummary {
            return CatalogSummary {
                onSale: productDb.Product.where(status: ProductStatus.Active).count(),
                outOfStock: productDb.Product.where(status: ProductStatus.Active, inventory: 0).count(),
                openAlerts: productDb.StockAlert.where(isOpen: true).count()
            };
        }
    }

    // What OrderService calls while a customer waits. Hidden: no client gets these.
    rest_api ProductInternalAPI : basePath('/api/v1/internal/products'), rdbms(productDb) {

        @path('/reserve')
        post reserveInventory(ReserveInventoryRequest request) : auth(service, providers: [platform]), hidden -> ReservationResponse {
            transaction(productDb) {
                foreach item in request.items {
                    let Product product = productDb.Product.findOrFail(item.productId);
                    if (product.status != ProductStatus.Active) {
                        throw NotOnSaleError();
                    }
                    if (product.inventory < item.quantity) {
                        throw InsufficientInventoryError();
                    }
                    product.inventory = product.inventory - item.quantity;
                    product.save();
                    productDb.InventoryReservation.create({
                        reservationId: request.reservationId,
                        productId: item.productId,
                        quantity: item.quantity,
                        expiresAt: DateTime.now().addSeconds(request.ttlSeconds)
                    });
                }
            }
            return ReservationResponse { success: true, reservationId: request.reservationId };
        }

        @path('/:id/facts')
        get productFacts(UUID id) : auth(service, providers: [platform]), hidden, idempotent -> ProductFacts {
            let Product product = productDb.Product.findOrFail(id);
            return ProductFacts { name: product.name, price: product.price };
        }
    }

    jobs {
        // Whatever was reserved and never paid for goes back on the shelf.
        job ReleaseExpiredReservations {
            let Array<InventoryReservation> expired = productDb.InventoryReservation
                .where(status: ReservationStatus.Reserved)
                .where(expiresAt: lt(DateTime.now()))
                .all();
            foreach reservation in expired {
                releaseReservation(reservation.reservationId, ReservationStatus.Expired);
            }
        }

        // A page view only bumps a cheap counter. This copies the counters to the column the home page sorts on.
        job UpdatePopularProducts {
            foreach product in productDb.Product.where(status: ProductStatus.Active).all() {
                let Int views = redis.ProductViews.get(product.id.toString()) ?? 0;
                product.viewCount = views;
                product.save();
            }
        }
    }

    test("a reservation must be for something") {
        let productDb.Category category = productDb.Category.create({ name: "Spec candles", slug: "spec-candles", art: ProductArt.Candle });
        let productDb.Product product = productDb.Product.create({
            name: "Spec candle",
            description: "For the spec",
            price: Money.of(29.99),
            status: ProductStatus.Active,
            slug: "spec-candle",
            categoryId: category.id
        });
        assert throws(
            () => productDb.InventoryReservation.create({
                reservationId: uuid(),
                productId: product.id,
                quantity: 0,
                expiresAt: DateTime.now().addDays(1)
            }),
            ValidationError("Reservation quantity must be positive")
        );
    }

    test("changing stock is announced") {
        let productDb.Category category = productDb.Category.create({ name: "Spec lamps", slug: "spec-lamps", art: ProductArt.Lamp });
        let productDb.Product product = productDb.Product.create({
            name: "Spec lamp",
            description: "For the spec",
            price: Money.of(19.99),
            status: ProductStatus.Active,
            slug: "spec-lamp",
            categoryId: category.id
        });
        product.inventory = 50;
        product.save();
        assert emitted(InventoryUpdated(product.id, 0, 50));
    }

    test("publishing puts a draft on sale") {
        let productDb.Category category = productDb.Category.create({ name: "Spec linen", slug: "spec-linen", art: ProductArt.Linen });
        let productDb.Product product = productDb.Product.create({
            name: "Spec napkin",
            description: "For the spec",
            price: Money.of(39.99),
            slug: "spec-napkin",
            categoryId: category.id
        });
        product.publish();
        assert product.status == ProductStatus.Active;
        product.discontinue();
        assert product.status == ProductStatus.Discontinued;
    }
}
