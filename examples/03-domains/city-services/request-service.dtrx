from cityservices.common import RequestCategory, RequestPriority, RequestStatus, generateRequestNumber, pointWkt;

// Service requests. A resident reports a problem with a street address and no account; the vendor
// turns the address into coordinates, the district service says whose area it is, and a reference
// number lets anyone track it. If the vendor cannot place the address the report is still kept,
// flagged for a dispatcher, because a resident's report must never be lost to a lookup failure.
service cityservices.RequestService('config/request-service.dcfg') : version('2.0.0'), description('Resident service requests') {

    discovery { }

    uses SmsProvider;
    uses GeocoderProvider;
    uses DistrictService;

    exceptions {
        InvalidTransitionError : status(409), message("The request cannot move to that state from where it is");
    }

    rdbms requestDb {

        entity ServiceRequest extends BaseEntity {
            String(30) requestNumber : unique, filterable;
            String(200) title : trim, filterable;
            Text description;
            RequestCategory category : filterable;
            RequestPriority priority : filterable, sortable = RequestPriority.Medium;
            RequestStatus status : filterable = RequestStatus.Open;
            String(300) address : trim;
            Float? latitude;
            Float? longitude;
            Geometry? location;
            UUID? districtId : index;
            String(200)? districtName : filterable;
            /// For status texts only; never in an answer.
            Phone? reporterPhone : hidden;

            Boolean needsLocation := latitude == null;

            index(status, priority);
            fulltext(title, description);

            afterUpdate {
                if (isChanged(status)) {
                    dispatch RequestStatusChanged(id, requestNumber, oldValue(status), status);
                }
            }
        }

        /// What happened to a request, in order. The table refuses every change and delete.
        entity RequestUpdate extends BaseEntity : appendOnly {
            UUID requestId : index;
            RequestStatus status;
            String(500) note;
        }
    }

    pubsub mq {
        topic RequestEvents {
            publish RequestStatusChanged(UUID requestId, String requestNumber, RequestStatus oldStatus, RequestStatus newStatus) {
                ensure oldStatus != newStatus;
            }
        }
    }

    subscribe RequestEvents {
        // Texts the reporter, if they left a number. The key means a redelivered event sends once.
        on RequestStatusChanged(UUID requestId, String requestNumber, RequestStatus oldStatus, RequestStatus newStatus) {
            let requestDb.ServiceRequest? request = requestDb.ServiceRequest.find(requestId);
            if (request != null && request.reporterPhone != null) {
                textReporter(request.reporterPhone, #"status-{requestId}-{newStatus}", #"Port Alder 311: {requestNumber} is now {newStatus}.");
            }
        }
    }

    struct ReportRequest {
        String(200) title;
        Text description;
        RequestCategory category;
        String(300) address;
        Phone? phone;
    }

    /// What a resident gets back and can look up: never the reporter's number.
    struct RequestView {
        String requestNumber;
        String title;
        RequestStatus status;
        String address;
        String? districtName;
        DateTime createdAt;
    }

    struct RequestPin {
        UUID id;
        String requestNumber;
        String title;
        RequestPriority priority;
        GeoPoint point;
    }

    struct AddNoteRequest {
        String(500) note;
    }

    struct SetPriorityRequest {
        RequestPriority priority;
    }

    struct QueueSummary {
        Int open;
        Int assigned;
        Int inProgress;
        Int needsLocation;
    }

    /// A text failing must not fail the change that caused it.
    fn textReporter(Phone to, String key, String body) {
        try {
            SmsProvider.SmsAPI.post.sendSms(SendSmsRequest { to: to, body: body, idempotencyKey: key });
        } catch (Exception e) {
            Log.warn("Status text not sent", { key: key });
        }
    }

    fn place(requestDb.ServiceRequest request) {
        try {
            let GeocodeResult found = GeocoderProvider.GeocoderAPI.post.geocode(GeocodeRequest { query: request.address });
            if (found.matched && found.latitude != null && found.longitude != null) {
                let DistrictMatch district = DistrictService.DistrictAPI.get.forLocation(latitude: found.latitude, longitude: found.longitude);
                request.latitude = found.latitude;
                request.longitude = found.longitude;
                request.location = GeoShape.fromWkt(pointWkt(found.latitude, found.longitude));
                request.districtId = district.districtId;
                request.districtName = district.name;
                request.save();
            }
        } catch (Exception e) {
            Log.warn("Report kept without a location: lookup failed", { requestId: request.id });
        }
    }

    fn viewOf(requestDb.ServiceRequest request) -> RequestView {
        return RequestView {
            requestNumber: request.requestNumber,
            title: request.title,
            status: request.status,
            address: request.address,
            districtName: request.districtName,
            createdAt: request.createdAt
        };
    }

    fn pinOf(requestDb.ServiceRequest request) -> RequestPin {
        return RequestPin {
            id: request.id,
            requestNumber: request.requestNumber,
            title: request.title,
            priority: request.priority,
            point: GeoPoint { latitude: request.latitude ?? 0.0, longitude: request.longitude ?? 0.0 }
        };
    }

    fn advance(requestDb.ServiceRequest request, RequestStatus expected, RequestStatus next, String note) {
        if (request.status != expected) {
            throw InvalidTransitionError();
        }
        request.status = next;
        request.save();
        requestDb.RequestUpdate.create({ requestId: request.id, status: next, note: note });
    }

    // What a resident can reach.
    rest_api ReportAPI : basePath('/api/v1/reports'), rdbms(requestDb) {
        post report(ReportRequest request) : auth(public) -> RequestView {
            let ServiceRequest created = ServiceRequest.create({
                requestNumber: generateRequestNumber(),
                title: request.title,
                description: request.description,
                category: request.category,
                address: request.address,
                reporterPhone: request.phone
            });
            RequestUpdate.create({ requestId: created.id, status: RequestStatus.Open, note: "Report received" });
            place(created);
            if (request.phone != null) {
                textReporter(request.phone, #"receipt-{created.id}", #"Port Alder 311: we have your report. Your reference is {created.requestNumber}.");
            }
            return viewOf(created);
        }

        @path('/track/:requestNumber')
        get track(String requestNumber) : auth(public) -> RequestView {
            let ServiceRequest found = ServiceRequest.where(requestNumber: requestNumber).firstOrFail();
            return viewOf(found);
        }

        // Open problems near a point: GeoSql lowers to ST_DWithin and ST_Distance.
        @path('/nearby')
        get nearby(Float latitude, Float longitude, Float radiusMeters) : auth(public) -> Array<RequestView> {
            let Array<ServiceRequest> near = ServiceRequest
                .where(status: RequestStatus.Open)
                .where(GeoSql.withinDistanceMeters(location, latitude, longitude, radiusMeters))
                .orderBy(GeoSql.distanceMeters(location, latitude, longitude))
                .all();
            return near.map(r => viewOf(r));
        }
    }

    // What city staff work with.
    rest_api QueueAPI : basePath('/api/v1/queue/requests'), rdbms(requestDb) {
        resource ServiceRequest : only(list), auth(required, providers: [identity], roles: [dispatcher, admin]);

        @path('/summary')
        get summary() : auth(required, providers: [identity], roles: [dispatcher, admin]) -> QueueSummary {
            return QueueSummary {
                open: ServiceRequest.where(status: RequestStatus.Open).count(),
                assigned: ServiceRequest.where(status: RequestStatus.Assigned).count(),
                inProgress: ServiceRequest.where(status: RequestStatus.InProgress).count(),
                needsLocation: ServiceRequest.whereNull(latitude).count()
            };
        }

        @path('/map')
        get pins() : auth(required, providers: [identity], roles: [dispatcher, admin]) -> Array<RequestPin> {
            let Array<ServiceRequest> open = ServiceRequest.where(status: RequestStatus.Open).all();
            return open.filter(r => r.latitude != null).map(r => pinOf(r));
        }

        @path('/:id')
        get request(UUID id) : auth(required, providers: [identity], roles: [dispatcher, admin]) -> ServiceRequest {
            return ServiceRequest.findOrFail(id);
        }

        @path('/:id/history')
        get history(UUID id) : auth(required, providers: [identity], roles: [dispatcher, admin]) -> Array<RequestUpdate> {
            return RequestUpdate.where(requestId: id).orderBy(createdAt: asc).all();
        }

        @path('/:id/assign')
        post assign(UUID id) : auth(required, providers: [identity], roles: [dispatcher, admin]), invalidates(request, history) -> ServiceRequest {
            let ServiceRequest found = ServiceRequest.findOrFail(id);
            advance(found, RequestStatus.Open, RequestStatus.Assigned, "Assigned to a crew");
            return found;
        }

        @path('/:id/start')
        post start(UUID id) : auth(required, providers: [identity], roles: [dispatcher, admin]), invalidates(request, history) -> ServiceRequest {
            let ServiceRequest found = ServiceRequest.findOrFail(id);
            advance(found, RequestStatus.Assigned, RequestStatus.InProgress, "Work started");
            return found;
        }

        @path('/:id/resolve')
        post resolve(UUID id) : auth(required, providers: [identity], roles: [dispatcher, admin]), invalidates(request, history) -> ServiceRequest {
            let ServiceRequest found = ServiceRequest.findOrFail(id);
            advance(found, RequestStatus.InProgress, RequestStatus.Resolved, "Marked resolved");
            return found;
        }

        @path('/:id/close')
        post close(UUID id) : auth(required, providers: [identity], roles: [dispatcher, admin]), invalidates(request, history) -> ServiceRequest {
            let ServiceRequest found = ServiceRequest.findOrFail(id);
            advance(found, RequestStatus.Resolved, RequestStatus.Closed, "Closed");
            return found;
        }

        @path('/:id/priority')
        post setPriority(UUID id, SetPriorityRequest request) : auth(required, providers: [identity], roles: [dispatcher, admin]), invalidates(request) -> ServiceRequest {
            let ServiceRequest found = ServiceRequest.findOrFail(id);
            found.priority = request.priority;
            found.save();
            return found;
        }
    }

    test("a new request is open and waits for a location") {
        let ServiceRequest request = requestDb.ServiceRequest.create({
            requestNumber: generateRequestNumber(),
            title: "Pothole on Harbor Street",
            description: "Deep enough to hurt a bicycle wheel",
            category: RequestCategory.Pothole,
            address: "12 Harbor Street"
        });
        assert request.status == RequestStatus.Open;
        assert request.needsLocation;
    }

    test("changing a request's status announces it") {
        let ServiceRequest request = requestDb.ServiceRequest.create({
            requestNumber: generateRequestNumber(),
            title: "Streetlight out",
            description: "Dark corner",
            category: RequestCategory.Streetlight,
            address: "3 Quay Road"
        });
        request.status = RequestStatus.Assigned;
        request.save();
        assert emitted(RequestStatusChanged(request.id, request.requestNumber, RequestStatus.Open, RequestStatus.Assigned));
    }
}
