config app cityservices.Citizen {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@portalder";
      }
    }
    appId = "com.example.portalder";
    strings = ["config/strings/citizen.en-US.dcfg"];
    map {
      tiles = "https://tile.openstreetmap.org/{z}/{x}/{y}.png";
      attribution = "Map data from OpenStreetMap contributors";
    }
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
