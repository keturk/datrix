config service cityservices.DistrictService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms districtDb from postgisContainer(id: "f4c6cf3e-c0de-432c-8fcb-7cf9831d29f5", database: "cityservices_district");
    httpSecurity from localHttpSecurity(host: "cityservices-district-service");
    serviceCredentialOps from machineCredential();
    jobs {
      jobs {
        ConvertBoundaries {
          schedule = "* * * * *";
          timeout = "60s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
