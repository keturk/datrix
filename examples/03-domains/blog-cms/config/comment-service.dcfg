config service blog.CommentService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8003;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms commentDb from postgresContainer(id: "7c1f0a52-3e0b-4d7a-9a55-6f1c2d7b8e01", database: "blog_comments");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "blog-comment-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in
      // seed/moderation-mock.dseed, so the example runs with nothing to configure. Any other
      // deployment must supply the handle's value.
      secret moderation_provider_api_key {
        required = true;
        purpose = "API key for the moderation vendor (ModerationProvider contract).";
        localDefault = "dev-only-moderation-api-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
