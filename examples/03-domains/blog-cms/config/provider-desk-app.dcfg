config app blog.ProviderDesk {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@fieldnotes";
      }
    }
    strings = ["config/strings/provider-desk.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4400; }
  }
  profile development as "dev" extends base {
    web { port = 4400; }
  }
  profile production as "prod" extends base {
    web { port = 4400; }
  }
}
