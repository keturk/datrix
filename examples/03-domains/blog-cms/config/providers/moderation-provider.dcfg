// Where the ModerationProvider contract is served. Every profile here points at the mock in the
// same stack; pointing one at a real vendor changes only this file.
config extern blog.ModerationProvider {
  base {
    deployment = "external";
    url = "http://blog-moderation-mock:8091";
    auth {
      type = "apiKey";
      header = "X-Moderation-Api-Key";
      // A logical handle; each consuming service declares it and its value is never in a file here.
      secret = "moderation_provider_api_key";
    }
    timeout = "5s";
    retry {
      maxAttempts = 2;
      backoff = "exponential";
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
