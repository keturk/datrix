config app blog.Reader {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@fieldnotes";
      }
    }
    appId = "com.example.fieldnotes";
    strings = ["config/strings/reader.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
