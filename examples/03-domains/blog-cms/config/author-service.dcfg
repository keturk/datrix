config service blog.AuthorService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms authorDb from postgresContainer(id: "33ba48db-1923-49dd-8bf6-24dcb512991c", database: "blog_authors");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "blog-author-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
