// Implements the MailProvider contract in the stack, so the application sends real requests and
// needs no email account: every message lands in an inbox the Provider Desk shows instead of
// reaching a person. Callers authenticate with an API key, as with a real provider.
service blog.MailMock('config/mocks/mail-mock.dcfg')
    : version('1.0.0'), description('In-stack mock of the email provider') {

    discovery { }

    enum MailStatus {
        Accepted : tone(info),
        Delivered : tone(success),
        Bounced : tone(danger)
    }

    rdbms mailDb {

        /// A message the provider accepted.
        entity SentMail extends BaseEntity {
            String(40) messageId : unique;
            String(120) idempotencyKey : unique;
            Email recipient : index, filterable;
            String(200) subject : filterable;
            Text body;
            MailStatus status = MailStatus.Delivered;
        }

        /// API keys the provider issued. Only the SHA-256 hash of a key is stored.
        entity ApiKey extends BaseEntity {
            String(64) keyHash : unique;
            UUID ownerId : index;
            Array<String> scopes = [];
            Boolean isActive = true;
            DateTime? expiresAt;
            DateTime? lastUsedAt;
        }
    }

    struct SendMailRequest {
        Email to;
        String(200) subject;
        Text body;
        String(120) idempotencyKey;
    }

    struct Mail {
        String(40) id;
        Email to;
        String(200) subject;
        MailStatus status;
        DateTime createdAt;
    }

    /// An address on the mock's own bounce domain bounces, so a failed delivery can be shown.
    const BOUNCE_DOMAIN = "@bounce.example.com";

    fn toMail(SentMail sent) -> Mail {
        return Mail {
            id: sent.messageId,
            to: sent.recipient,
            subject: sent.subject,
            status: sent.status,
            createdAt: sent.createdAt
        };
    }

    // The provider's public API: exactly the MailProvider contract.
    rest_api MailAPI : basePath('/v1'), rdbms(mailDb) {
        @path('/messages')
        post(SendMailRequest request) : auth(required, providers: [mailKeys]) -> Mail {
            let SentMail? existing = SentMail.where(idempotencyKey: request.idempotencyKey).first();
            if (existing != null) {
                return toMail(existing);
            }
            let SentMail created = SentMail.create({
                messageId: #"msg_{Random.string(24, '0123456789abcdef')}",
                idempotencyKey: request.idempotencyKey,
                recipient: request.to,
                subject: request.subject,
                body: request.body,
                status: request.to.toString().endsWith(BOUNCE_DOMAIN) ? MailStatus.Bounced : MailStatus.Delivered
            });
            return toMail(created);
        }

        @path('/messages/:id')
        get(String id) : auth(required, providers: [mailKeys]) -> Mail {
            let SentMail sent = SentMail.where(messageId: id).firstOrFail();
            return toMail(sent);
        }
    }

    // What the Provider Desk shows: the inbox of everything sent.
    rest_api MailDeskAPI : basePath('/api/v1/desk/mail'), rdbms(mailDb) {
        resource SentMail : only(list, get), auth(required, providers: [identity], roles: [operator]);
    }

    test("a repeated idempotency key finds the first message") {
        let SentMail first = mailDb.SentMail.create({
            messageId: "msg_0001",
            idempotencyKey: "welcome-1",
            recipient: "reader@example.com",
            subject: "Welcome",
            body: "Hello"
        });
        let SentMail? again = mailDb.SentMail.where(idempotencyKey: "welcome-1").first();
        assert again != null;
        assert again.messageId == first.messageId;
    }
}
