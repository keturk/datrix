// Restaurants, their menus and the delivery zones, and the application's identity block. Browsing is
// public. A peer service asks here for a price, so an order is never charged a price the customer's
// own device sent.
service fooddelivery.RestaurantService('config/restaurant-service.dcfg') : version('2.0.0'), description('Restaurants, menus and delivery zones') {

    discovery { }

    identity {
        // Customers register themselves. Kitchen, driver and operator roles are granted, never
        // self-assigned. Sign-in belongs to the hosted identity provider, so nothing here handles
        // a password.
        provider identity config('config/identity/identity.dcfg') {
            Email email;
            String? fullName;

            group "kitchen" as kitchen;
            group "driver" as driver;
            group "operator" as operator;
        }

        // Service-to-service callers.
        provider machine config('config/identity/machine.dcfg') {
        }

        // API keys the mocks issue, the way a real vendor authenticates its API callers.
        provider paymentKeys config('config/identity/payment-keys.dcfg') {
        }

        provider routeKeys config('config/identity/route-keys.dcfg') {
        }

        provider smsKeys config('config/identity/sms-keys.dcfg') {
        }
    }

    exceptions {
        ItemUnavailableError : status(409), message("That dish is not available right now");
        RestaurantClosedError : status(409), message("This restaurant is closed right now");
    }

    enum Cuisine {
        Thai,
        Italian,
        Mexican,
        Indian,
        Japanese
    }

    rdbms restaurantDb {

        entity Restaurant extends BaseEntity {
            String(200) name : trim, filterable, sortable;
            Cuisine cuisine : filterable;
            String(300) address;
            Float latitude;
            Float longitude;
            Text description;
            Boolean isOpen : filterable = true;

            hasMany MenuItem;
        }

        entity MenuItem extends BaseEntity {
            String(200) name : trim, filterable;
            String(500) description;
            Money price : positive, sortable;
            String(60) section : filterable;
            Boolean isAvailable : filterable = true;

            belongsTo Restaurant : index;
        }

        /// Where the restaurants deliver, and what it costs to reach.
        entity DeliveryZone extends BaseEntity {
            String(120) name : unique, trim;
            Float latitude;
            Float longitude;
            Money fee;
        }
    }

    struct MenuSection {
        String section;
        Array<restaurantDb.MenuItem> items;
    }

    struct RestaurantMenu {
        restaurantDb.Restaurant restaurant;
        Array<restaurantDb.MenuItem> items;
    }

    struct PricedItem {
        UUID menuItemId;
        UUID restaurantId;
        String restaurantName;
        String name;
        Money price;
    }

    struct PricedDelivery {
        String restaurantName;
        String pickupAddress;
        Float pickupLatitude;
        Float pickupLongitude;
        String zoneName;
        Float dropoffLatitude;
        Float dropoffLongitude;
        Money fee;
    }

    struct SetAvailableRequest {
        Boolean isAvailable;
    }

    struct SetOpenRequest {
        Boolean isOpen;
    }

    rest_api RestaurantAPI : basePath('/api/v1/restaurants'), rdbms(restaurantDb) {
        resource Restaurant : only(list, get), auth(public);

        @path('/zones')
        get zones() : auth(public) -> Array<DeliveryZone> {
            return DeliveryZone.where().orderBy(name: asc).all();
        }

        @path('/:id/menu')
        get menu(UUID id) : auth(public) -> RestaurantMenu {
            let Restaurant restaurant = Restaurant.findOrFail(id);
            return RestaurantMenu {
                restaurant: restaurant,
                items: MenuItem.where(restaurantId: id, isAvailable: true).orderBy(section: asc).all()
            };
        }
    }

    // What the kitchen edits.
    rest_api KitchenMenuAPI : basePath('/api/v1/kitchen/menu'), rdbms(restaurantDb) {
        resource MenuItem : only(list, create, update), auth(required, providers: [identity], roles: [kitchen]);

        @path('/:id/available')
        post setAvailable(UUID id, SetAvailableRequest request) : auth(required, providers: [identity], roles: [kitchen]) -> MenuItem {
            let MenuItem item = MenuItem.findOrFail(id);
            item.isAvailable = request.isAvailable;
            item.save();
            return item;
        }

        @path('/restaurants/:id/open')
        post setOpen(UUID id, SetOpenRequest request) : auth(required, providers: [identity], roles: [kitchen]) -> Restaurant {
            let Restaurant restaurant = Restaurant.findOrFail(id);
            restaurant.isOpen = request.isOpen;
            restaurant.save();
            return restaurant;
        }
    }

    // What OrderService asks. Only a service with a machine credential reaches these.
    rest_api PricingAPI : basePath('/api/v1/internal/pricing'), rdbms(restaurantDb) {
        @path('/items/:id')
        get priceItem(UUID id) : auth(service, providers: [machine]) -> PricedItem {
            let MenuItem item = MenuItem.findOrFail(id);
            let Restaurant restaurant = Restaurant.findOrFail(item.restaurantId);
            if (!item.isAvailable) {
                throw ItemUnavailableError();
            }
            if (!restaurant.isOpen) {
                throw RestaurantClosedError();
            }
            return PricedItem {
                menuItemId: item.id,
                restaurantId: restaurant.id,
                restaurantName: restaurant.name,
                name: item.name,
                price: item.price
            };
        }

        @path('/deliveries')
        get priceDelivery(UUID restaurantId, UUID zoneId) : auth(service, providers: [machine]) -> PricedDelivery {
            let Restaurant restaurant = Restaurant.findOrFail(restaurantId);
            let DeliveryZone zone = DeliveryZone.findOrFail(zoneId);
            return PricedDelivery {
                restaurantName: restaurant.name,
                pickupAddress: restaurant.address,
                pickupLatitude: restaurant.latitude,
                pickupLongitude: restaurant.longitude,
                zoneName: zone.name,
                dropoffLatitude: zone.latitude,
                dropoffLongitude: zone.longitude,
                fee: zone.fee
            };
        }
    }

    test("a new dish is available") {
        let Restaurant restaurant = restaurantDb.Restaurant.create({
            name: "Lemongrass",
            cuisine: Cuisine.Thai,
            address: "4 Market Row",
            latitude: 45.51,
            longitude: -122.67,
            description: "Fresh curries"
        });
        let MenuItem item = restaurantDb.MenuItem.create({
            restaurantId: restaurant.id,
            name: "Green curry",
            description: "With basil",
            price: 12.50,
            section: "Mains"
        });
        assert item.isAvailable;
    }
}
