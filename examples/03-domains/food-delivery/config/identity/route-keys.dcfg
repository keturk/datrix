// API keys of the maps vendor. mode = self: RouteMock issues and verifies them itself, as a real
// vendor would, and only the SHA-256 hash of a key is stored.
config identity routeKeys {
  base {
    provider = "apiKey";
    mode = "self";
    audience = "workforce";
    apiKey {
      header = "X-Route-Api-Key";
      store = "fooddelivery.RouteMock";
      storeBlock = "routeDb";
      entity = "ApiKey";
      fields {
        hash = "keyHash";
        owner = "ownerId";
        scopes = "scopes";
        active = "isActive";
        expiresAt = "expiresAt";
        lastUsedAt = "lastUsedAt";
      }
      lastUsedResolutionSeconds = 60;
      serviceProviders = ["machine"];
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
