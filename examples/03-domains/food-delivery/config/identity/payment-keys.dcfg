// API keys of the card payment vendor. mode = self: PaymentMock issues and verifies them itself, as
// a real vendor would, and only the SHA-256 hash of a key is stored.
config identity paymentKeys {
  base {
    provider = "apiKey";
    mode = "self";
    audience = "workforce";
    apiKey {
      header = "X-Payment-Api-Key";
      store = "fooddelivery.PaymentMock";
      storeBlock = "paymentDb";
      entity = "ApiKey";
      fields {
        hash = "keyHash";
        owner = "ownerId";
        scopes = "scopes";
        active = "isActive";
        expiresAt = "expiresAt";
        lastUsedAt = "lastUsedAt";
      }
      lastUsedResolutionSeconds = 60;
      serviceProviders = ["machine"];
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
