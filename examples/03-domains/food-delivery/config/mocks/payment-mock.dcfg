config service fooddelivery.PaymentMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8090;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms paymentDb from postgresContainer(id: "f056fa2f-3f25-4291-a464-01062771a3fc", database: "fooddelivery_payment_mock");
    httpSecurity from localHttpSecurity(host: "fooddelivery-payment-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
