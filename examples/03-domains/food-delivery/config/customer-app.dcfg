config app fooddelivery.Customer {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@saltbox";
      }
    }
    appId = "com.example.saltbox";
    strings = ["config/strings/customer.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
