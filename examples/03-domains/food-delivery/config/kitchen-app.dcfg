config app fooddelivery.Kitchen {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@saltbox";
      }
    }
    strings = ["config/strings/kitchen.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4300; }
  }
  profile development as "dev" extends base {
    web { port = 4300; }
  }
  profile production as "prod" extends base {
    web { port = 4300; }
  }
}
