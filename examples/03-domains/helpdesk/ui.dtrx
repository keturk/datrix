// What the Lanternpost apps take from its brand: colours, type and the shape of a page.
module helpdesk.ui {

    theme Brand {
        color primary      = '#0f5c6e';
        color onPrimary    = '#ffffff';
        color surface      = '#ffffff';
        color onSurface    = '#14272d';
        color background   = '#f2f7f8';
        color onBackground = '#14272d';
        color success      = '#166534';
        color onSuccess    = '#ffffff';
        color warning      = '#854d0e';
        color onWarning    = '#ffffff';
        color info         = '#1e40af';
        color onInfo       = '#ffffff';
        color danger       = '#991b1b';
        color onDanger     = '#ffffff';
        color neutral      = '#55696f';
        color onNeutral    = '#ffffff';
        space sm           = 8;
        space md           = 16;
        space lg           = 24;
        radius card        = 10;
        font body          = font('Inter', 15, 400);
        font heading       = font('Inter', 24, 600);
        breakpoint md      = 768;
        breakpoint lg      = 1024;
        scheme dark {
            color surface      = '#1d2c31';
            color onSurface    = '#e5eff1';
            color background   = '#142125';
            color onBackground = '#e5eff1';
            color primary      = '#83cfe0';
            color onPrimary    = '#0a3540';
        }
    }

    /// Figures across the top of a page.
    style statRow {
        columns: 2;
        gap: space.md;
        at (md) { columns: 4; }
    }

    /// Articles and topics.
    style cardGrid {
        columns: 1;
        gap: space.md;
        at (md) { columns: 2; }
    }
}
