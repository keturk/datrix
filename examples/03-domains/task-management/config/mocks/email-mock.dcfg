config service taskapp.EmailMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8091;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms emailDb from postgresContainer(id: "81186eba-fbbf-49b2-a433-15b4d1e8e74a", database: "taskapp_email_mock");
    httpSecurity from localHttpSecurity(host: "taskapp-email-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
