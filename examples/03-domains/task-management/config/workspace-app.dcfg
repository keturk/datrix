config app taskapp.Workspace {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@millrace";
      }
    }
    appId = "com.example.millrace";
    strings = ["config/strings/workspace.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
