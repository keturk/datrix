from healthcare.common import generateRecordNumber;

// Who the patients are, and whether their insurance is good today. A person who signs in gets a
// patient record on first use and fills in the rest; the front desk can also add a walk-in, who has
// no sign-in at all.
service healthcare.PatientService('config/patient-service.dcfg') : version('2.0.0'), description('Patients and their coverage') {

    discovery { }

    identity {
        // Patients register themselves. The clinician, frontDesk and operator roles are granted, never
        // self-assigned. Sign-in belongs to the hosted identity provider, so nothing here handles a
        // password.
        provider identity config('config/identity/identity.dcfg') {
            Email email;
            String? fullName;

            group "clinician" as clinician;
            group "frontDesk" as frontDesk;
            group "operator" as operator;
        }

        // Service-to-service callers.
        provider machine config('config/identity/machine.dcfg') {
        }

        // API keys the mocks issue, the way a real vendor authenticates its API callers.
        provider insurerKeys config('config/identity/insurer-keys.dcfg') {
        }

        provider pharmacyKeys config('config/identity/pharmacy-keys.dcfg') {
        }

        provider smsKeys config('config/identity/sms-keys.dcfg') {
        }
    }

    uses InsurerProvider;

    enum CoverageStatus {
        Unverified : tone(neutral),
        Active : tone(success),
        Inactive : tone(danger)
    }

    rdbms patientDb : audit {

        entity Patient extends BaseEntity {
            String(20) recordNumber : unique, filterable;
            String(200) fullName : filterable;
            Date? dateOfBirth;
            Phone? phone;
            String(300)? allergies;
            String(30)? memberId;
            String(60)? planName;
            CoverageStatus coverage : filterable = CoverageStatus.Unverified;
            Money? copay;
            DateTime? coverageCheckedAt;
            /// The sign-in behind this record. A walk-in has none.
            String(64)? userId : unique, hidden;
        }
    }

    struct SaveDetailsRequest {
        Date dateOfBirth;
        Phone phone;
        String(300)? allergies;
        String(30)? memberId;
    }

    struct AddPatientRequest {
        String(200) fullName;
        Date dateOfBirth;
        Phone? phone;
        String(30)? memberId;
    }

    struct CardForUserRequest {
        String(64) userId;
        String(200) fullName;
    }

    /// What another service needs to know about a patient, and no more.
    struct PatientCard {
        UUID id;
        String(64)? userId;
        String(20) recordNumber;
        String(200) fullName;
        Phone? phone;
        String(30)? memberId;
        CoverageStatus coverage;
        String(300)? allergies;
    }

    fn cardOf(patientDb.Patient patient) -> PatientCard {
        return PatientCard {
            id: patient.id,
            userId: patient.userId,
            recordNumber: patient.recordNumber,
            fullName: patient.fullName,
            phone: patient.phone,
            memberId: patient.memberId,
            coverage: patient.coverage,
            allergies: patient.allergies
        };
    }

    /// Asks the insurer. An insurer that cannot be reached leaves the patient unverified, and the
    /// front desk can ask again; it never turns into a claim that the patient is covered.
    fn verifyCoverage(patientDb.Patient patient) {
        if (patient.memberId == null) {
            patient.coverage = CoverageStatus.Unverified;
            patient.planName = null;
            patient.copay = null;
            return;
        }
        try {
            let EligibilityAnswer answer = InsurerProvider.InsurerAPI.post.checkEligibility(EligibilityRequest { memberId: patient.memberId });
            patient.coverage = answer.status == EligibilityStatus.Active ? CoverageStatus.Active : CoverageStatus.Inactive;
            patient.planName = answer.planName;
            patient.copay = answer.copay;
            patient.coverageCheckedAt = DateTime.now();
        } catch (Exception e) {
            patient.coverage = CoverageStatus.Unverified;
            Log.warn("Coverage check failed", { recordNumber: patient.recordNumber });
        }
    }

    fn patientForUser(String userId, String fullName) -> patientDb.Patient {
        let patientDb.Patient? existing = patientDb.Patient.where(userId: userId).first();
        if (existing != null) {
            return existing;
        }
        return patientDb.Patient.create({
            recordNumber: generateRecordNumber(),
            fullName: fullName,
            userId: userId
        });
    }

    // What a signed-in patient sees of themselves. Each route finds the record by the sign-in, so
    // nobody can name another patient's record here.
    rest_api PortalAPI : basePath('/api/v1/portal/patient'), rdbms(patientDb) {
        @path('/me')
        get me() : auth(required, providers: [identity]) -> Patient {
            return patientForUser(Auth.userId(), (Auth.identity.fullName ?? Auth.identity.email).toString());
        }

        @path('/me/details')
        post saveDetails(SaveDetailsRequest request) : auth(required, providers: [identity]) -> Patient {
            let Patient patient = patientForUser(Auth.userId(), (Auth.identity.fullName ?? Auth.identity.email).toString());
            patient.dateOfBirth = request.dateOfBirth;
            patient.phone = request.phone;
            patient.allergies = request.allergies;
            patient.memberId = request.memberId;
            verifyCoverage(patient);
            patient.save();
            return patient;
        }
    }

    // What the clinic works with.
    rest_api ClinicPatientAPI : basePath('/api/v1/clinic/patients'), rdbms(patientDb) {
        resource Patient : only(list, get), auth(required, providers: [identity], roles: [clinician, frontDesk]);

        @path('/walk-in')
        post addWalkIn(AddPatientRequest request) : auth(required, providers: [identity], roles: [frontDesk]) -> Patient {
            let Patient created = Patient.create({
                recordNumber: generateRecordNumber(),
                fullName: request.fullName,
                dateOfBirth: request.dateOfBirth,
                phone: request.phone,
                memberId: request.memberId
            });
            verifyCoverage(created);
            created.save();
            return created;
        }

        @path('/:id/verify-coverage')
        post recheckCoverage(UUID id) : auth(required, providers: [identity], roles: [frontDesk]) -> Patient {
            let Patient patient = Patient.findOrFail(id);
            verifyCoverage(patient);
            patient.save();
            return patient;
        }
    }

    // What the other services read. Only a service with a machine credential reaches these.
    rest_api PatientCardAPI : basePath('/api/v1/internal/patients'), rdbms(patientDb) {
        @path('/:id/card')
        get cardById(UUID id) : auth(service, providers: [machine]) -> PatientCard {
            return cardOf(Patient.findOrFail(id));
        }

        @path('/card-for-user')
        post cardForUser(CardForUserRequest request) : auth(service, providers: [machine]) -> PatientCard {
            return cardOf(patientForUser(request.userId, request.fullName));
        }
    }

    test("a new patient starts unverified") {
        let patientDb.Patient created = patientDb.Patient.create({
            recordNumber: "FC-000001",
            fullName: "Ana Ferreira"
        });
        assert created.coverage == CoverageStatus.Unverified;
    }
}
