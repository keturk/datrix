// The people who use Ferncrest. The generated stack hosts the sign-in: nothing here or in a service
// ever handles a password. Anyone may register as a patient; the clinician, frontDesk and operator
// roles are granted, never self-assigned.
config identity identity {
  base {
    audience = "workforce";
    mode = "platformManaged";
    jwksCacheTtlSeconds = 3600;
    signUp {
      allowed = true;
    }
    publicClient {
      flows = ["authorization_code"];
    }
    identityFields {
      email {
        claimPath = "email";
        guarantee = "required";
        syncPolicy = "syncOnAuth";
      }
      fullName {
        claimPath = "name";
        guarantee = "optional";
        syncPolicy = "syncOnAuth";
      }
    }
    roleSource {
      claimPath = "urn:zitadel:iam:org:project:roles";
      guarantee = "optional";
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
