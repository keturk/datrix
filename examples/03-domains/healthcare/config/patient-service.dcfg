config service healthcare.PatientService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms patientDb from postgresContainer(id: "f4c2356d-d373-4836-9a63-b75f60bbb3ec", database: "healthcare_patient");
    httpSecurity from localHttpSecurity(host: "healthcare-patient-service");
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in
      // seed/insurer-mock.dseed, so the example runs with nothing to configure. Any other deployment
      // must supply the handle's value.
      secret insurer_provider_api_key {
        required = true;
        purpose = "API key for the insurer (InsurerProvider contract).";
        localDefault = "dev-only-insurer-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
