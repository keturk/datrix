config service healthcare.PharmacyMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8091;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms pharmacyDb from postgresContainer(id: "57c91966-ab17-45bf-8861-216dc66c0d2a", database: "healthcare_pharmacy_mock");
    httpSecurity from localHttpSecurity(host: "healthcare-pharmacy-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
