config service healthcare.SmsMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8092;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms smsDb from postgresContainer(id: "ce282dbe-574a-4b3b-a6aa-85db48677349", database: "healthcare_sms_mock");
    httpSecurity from localHttpSecurity(host: "healthcare-sms-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
