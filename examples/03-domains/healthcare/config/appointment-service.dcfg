config service healthcare.AppointmentService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8002;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms appointmentDb from postgresContainer(id: "4df53a79-0fcf-47d3-ae08-0878aea1adcb", database: "healthcare_appointment");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "healthcare-appointment-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    jobs {
      jobs {
        SendReminders {
          schedule = "0 * * * *";
          timeout = "300s";
        }
        MarkNoShows {
          schedule = "*/15 * * * *";
          timeout = "120s";
        }
        OpenSlots {
          schedule = "0 2 * * *";
          timeout = "300s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in
      // seed/sms-mock.dseed, so the example runs with nothing to configure. Any other deployment must
      // supply the handle's value.
      secret sms_provider_api_key {
        required = true;
        purpose = "API key for the text vendor (SmsProvider contract).";
        localDefault = "dev-only-sms-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
