config app healthcare.Portal {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@ferncrest";
      }
    }
    appId = "com.example.ferncrest";
    strings = ["config/strings/portal.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
