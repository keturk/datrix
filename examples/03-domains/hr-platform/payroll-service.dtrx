from hr.common import Department;

// Pay. A run is prepared from everyone's pay profile, a second person has to approve it, and paying it
// sends one payout per person with a key that makes the whole run safe to press twice. A payout the
// bank rejects fails that one payslip and leaves the rest paid.
service hr.PayrollService('config/payroll-service.dcfg') : version('2.0.0'), description('Pay runs and payslips') {

    discovery { }

    uses BankProvider;
    uses EmployeeService;

    // A renamed person is paid under the new name, and someone who has left drops off the next run.
    subscribe EmployeeEvents {
        on EmployeeChanged(UUID employeeId, String fullName, String jobTitle, Email workEmail, Department department, EmployeeStatus status) {
            let payrollDb.PayProfile? profile = payrollDb.PayProfile.where(employeeId: employeeId).first();
            if (profile != null) {
                profile.employeeName = fullName;
                profile.department = department;
                profile.isActive = status != EmployeeStatus.Left;
                profile.save();
            }
        }
    }

    exceptions {
        RunExistsError : status(409), message("There is already a pay run for this month");
        NotDraftError : status(409), message("Only a draft run can be approved");
        SamePersonError : status(403), message("Whoever prepared a run cannot approve it. Ask someone else in HR");
        NotApprovedError : status(409), message("Only an approved run can be paid");
    }

    enum RunStatus {
        Draft : tone(warning),
        Approved : tone(info),
        Paid : tone(success),
        PaidWithFailures : tone(danger)
    }

    enum PayslipStatus {
        Pending : tone(warning),
        Paid : tone(success),
        Failed : tone(danger)
    }

    /// What a run keeps back for tax, as a share of gross pay.
    const TAX_RATE = 0.22;

    rdbms payrollDb : audit {

        /// What someone is paid and where. The account number stays in this service.
        entity PayProfile extends BaseEntity {
            String(200) employeeName : filterable;
            Department department : filterable;
            Email workEmail : unique;
            Money annualSalary;
            String(34) accountNumber : hidden;
            Boolean isActive : filterable = true;
            UUID employeeId : unique;
        }

        entity PayRun extends BaseEntity {
            String(7) period : unique, filterable;
            RunStatus status : filterable = RunStatus.Draft;
            Int people = 0;
            Money totalGross;
            Money totalNet;
            String(200) preparedByName;
            String(200)? approvedByName;
            DateTime? paidAt;
            UUID? preparedBy : hidden;
        }

        entity Payslip extends BaseEntity {
            String(7) period : filterable;
            String(200) employeeName : filterable;
            Money gross;
            Money tax;
            Money net;
            PayslipStatus status : filterable = PayslipStatus.Pending;
            String(200)? failureReason;
            String(40)? payoutId : hidden;
            Email workEmail : index, hidden;
            UUID employeeId : index;

            belongsTo PayRun : index;
        }
    }

    struct PrepareRunRequest {
        String(7) period;
    }

    struct EnrollRequest {
        UUID employeeId;
        String(200) employeeName;
        Department department;
        Email workEmail;
        Money annualSalary;
        String(34) accountNumber;
    }

    /// All the recruiting service needs back: the account number stays here.
    struct EnrolledProfile {
        UUID id;
    }

    struct RunDetail {
        payrollDb.PayRun run;
        Array<payrollDb.Payslip> payslips;
    }

    /// Builds a run from everyone with an active profile. A job and a person both come here, so the
    /// unique period is what stops a second run for one month.
    fn prepareRun(String period, UUID? preparedBy, String preparedByName) -> payrollDb.PayRun {
        if (payrollDb.PayRun.where(period: period).first() != null) {
            throw RunExistsError();
        }
        let Array<payrollDb.PayProfile> profiles = payrollDb.PayProfile.where(isActive: true).limit(5000).all();
        let Money totalGross = 0.00;
        let Money totalNet = 0.00;
        let payrollDb.PayRun run = payrollDb.PayRun.create({
            period: period,
            preparedBy: preparedBy,
            preparedByName: preparedByName,
            people: profiles.length,
            totalGross: 0.00,
            totalNet: 0.00
        });
        foreach profile in profiles {
            let Money gross = Math.round(profile.annualSalary / 12, 2);
            let Money tax = Math.round(gross * TAX_RATE, 2);
            let Money net = gross - tax;
            payrollDb.Payslip.create({
                payRunId: run.id,
                period: period,
                employeeId: profile.employeeId,
                employeeName: profile.employeeName,
                workEmail: profile.workEmail,
                gross: gross,
                tax: tax,
                net: net
            });
            totalGross = totalGross + gross;
            totalNet = totalNet + net;
        }
        run.totalGross = totalGross;
        run.totalNet = totalNet;
        run.save();
        return run;
    }

    // What HR works with.
    rest_api PayrollAPI : basePath('/api/v1/payroll'), rdbms(payrollDb) {
        resource PayRun : only(list), auth(required, providers: [identity], roles: [hr]);
        resource PayProfile : only(list), auth(required, providers: [identity], roles: [hr]);

        @path('/runs')
        post prepare(PrepareRunRequest request) : auth(required, providers: [identity], roles: [hr]) -> PayRun {
            return prepareRun(request.period, Auth.userId(), (Auth.identity.fullName ?? Auth.identity.email).toString());
        }

        @path('/runs/:id')
        get runDetail(UUID id) : auth(required, providers: [identity], roles: [hr]) -> RunDetail {
            let PayRun run = PayRun.findOrFail(id);
            return RunDetail {
                run: run,
                payslips: Payslip.where(payRunId: id).orderBy(employeeName: asc).limit(5000).all()
            };
        }

        @path('/latest')
        get latest() : auth(required, providers: [identity], roles: [hr, manager]) -> PayRun? {
            return PayRun.orderBy(period: desc).first();
        }

        // Two people: the one who prepared a run cannot be the one who approves it.
        @path('/runs/:id/approve')
        post approve(UUID id) : auth(required, providers: [identity], roles: [hr]) -> PayRun {
            let PayRun run = PayRun.findOrFail(id);
            if (run.status != RunStatus.Draft) {
                throw NotDraftError();
            }
            if (run.preparedBy == Auth.userId()) {
                throw SamePersonError();
            }
            run.status = RunStatus.Approved;
            run.approvedByName = (Auth.identity.fullName ?? Auth.identity.email).toString();
            run.save();
            return run;
        }

        // Each payout carries a key made of the run and the person, so pressing this twice, or running
        // it again after a timeout, never pays anyone twice.
        @path('/runs/:id/pay')
        post pay(UUID id) : auth(required, providers: [identity], roles: [hr]) -> PayRun {
            let PayRun run = PayRun.findOrFail(id);
            if (run.status != RunStatus.Approved) {
                throw NotApprovedError();
            }
            let Boolean anyFailed = false;
            let Array<Payslip> payslips = Payslip.where(payRunId: id, status: PayslipStatus.Pending).limit(5000).all();
            foreach payslip in payslips {
                let PayProfile profile = PayProfile.where(employeeId: payslip.employeeId).firstOrFail();
                try {
                    let Payout payout = BankProvider.BankAPI.post.createPayout(CreatePayoutRequest {
                        accountNumber: profile.accountNumber,
                        amount: payslip.net,
                        reference: #"Salary {payslip.period}",
                        idempotencyKey: #"pay-{run.id}-{payslip.employeeId}"
                    });
                    payslip.payoutId = payout.id;
                    if (payout.status == PayoutStatus.Settled) {
                        payslip.status = PayslipStatus.Paid;
                    } else {
                        payslip.status = PayslipStatus.Failed;
                        payslip.failureReason = payout.rejectionReason;
                        anyFailed = true;
                    }
                } catch (Exception e) {
                    payslip.status = PayslipStatus.Failed;
                    payslip.failureReason = "The bank could not be reached";
                    anyFailed = true;
                }
                payslip.save();
            }
            run.status = anyFailed ? RunStatus.PaidWithFailures : RunStatus.Paid;
            run.paidAt = DateTime.now();
            run.save();
            return run;
        }
    }

    // An employee's own payslips, found by their sign-in.
    rest_api MyPayAPI : basePath('/api/v1/my-pay'), rdbms(payrollDb) {
        @path('/payslips')
        get myPayslips() : auth(required, providers: [identity]) -> Array<Payslip> {
            return Payslip.where(workEmail: Auth.identity.email.toString()).orderBy(period: desc).limit(36).all();
        }
    }

    // What the recruiting service reports. Only a service with a machine credential reaches this.
    rest_api EnrollmentAPI : basePath('/api/v1/internal/payroll'), rdbms(payrollDb) {
        @path('/enroll')
        post enroll(EnrollRequest request) : auth(service, providers: [machine]) -> EnrolledProfile {
            let PayProfile? existing = PayProfile.where(employeeId: request.employeeId).first();
            if (existing != null) {
                return EnrolledProfile { id: existing.id };
            }
            let PayProfile created = PayProfile.create({
                employeeId: request.employeeId,
                employeeName: request.employeeName,
                department: request.department,
                workEmail: request.workEmail,
                annualSalary: request.annualSalary,
                accountNumber: request.accountNumber
            });
            return EnrolledProfile { id: created.id };
        }
    }

    jobs {
        // On the 25th, the month's run is waiting in Draft. A person still approves and pays it.
        job PrepareMonthlyRun {
            let String period = DateTime.now().format('yyyy-MM');
            if (payrollDb.PayRun.where(period: period).first() == null) {
                prepareRun(period, null, "The monthly job");
            }
        }
    }

    test("a new run waits as a draft") {
        let payrollDb.PayRun run = payrollDb.PayRun.create({
            period: "2026-01",
            preparedByName: "Ana Ferreira",
            totalGross: 0.00,
            totalNet: 0.00
        });
        assert run.status == RunStatus.Draft;
    }
}
