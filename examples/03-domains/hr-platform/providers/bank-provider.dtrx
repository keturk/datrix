// The contract of the payroll bank. config/providers/bank-provider.dcfg says where it is served.
extern service hr.BankProvider('config/providers/bank-provider.dcfg')
    : version('1.0.0'), description('Salary payouts') {

    enum PayoutStatus {
        Settled,
        Rejected
    }

    struct CreatePayoutRequest {
        String(34) accountNumber;
        Money amount;
        String(60) reference;
        /// The caller's key: paying again with the same key returns the first payout.
        String(120) idempotencyKey;
    }

    struct Payout {
        String(40) id;
        PayoutStatus status;
        String(200)? rejectionReason;
    }

    rest_api BankAPI : basePath('/v1') {
        @path('/payouts')
        post createPayout(CreatePayoutRequest request) -> Payout {
            ensure request.amount > 0;
            ensure request.idempotencyKey != "";
        }
    }

    errors {
        AccountClosed(String message);
    }

    auth : apiKey(header: 'X-Bank-Api-Key');
    health : path('/health');
}
