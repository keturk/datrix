config app hr.Careers {
  base {
    targets = ["angular"];
    clients {
      angular {
        scope = "@alderbrook";
      }
    }
    strings = ["config/strings/careers.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4400; }
  }
  profile development as "dev" extends base {
    web { port = 4400; }
  }
  profile production as "prod" extends base {
    web { port = 4400; }
  }
}
