config app hr.Employee {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@alderbrook";
      }
    }
    appId = "com.example.alderbrook";
    strings = ["config/strings/employee.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
