config service hr.RecruitmentService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8003;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms recruitDb from postgresContainer(id: "92798a28-2417-49b8-9d38-d92c6a80d9a7", database: "hr_recruitment");
    httpSecurity from localHttpSecurity(host: "hr-recruitment-service");
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    jobs {
      jobs {
        SyncVendors {
          schedule = "*/2 * * * *";
          timeout = "110s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // Each default only exists on a local stack, where it matches the hash seeded in that mock's
      // seed file, so the example runs with nothing to configure. Any other deployment must supply
      // the handle's value.
      secret check_provider_api_key {
        required = true;
        purpose = "API key for the background check vendor (CheckProvider contract).";
        localDefault = "dev-only-check-key-not-a-credential";
      }
      secret signature_provider_api_key {
        required = true;
        purpose = "API key for the e-signature vendor (SignatureProvider contract).";
        localDefault = "dev-only-signature-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
