config service hr.EmployeeService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms employeeDb from postgresContainer(id: "e02cfa74-987b-4aa3-8eea-8c079965c5b1", database: "hr_employee");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "hr-employee-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    serviceCredentialOps from machineCredential();
    jobs {
      jobs {
        RebuildDirectory {
          schedule = "*/5 * * * *";
          timeout = "120s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
