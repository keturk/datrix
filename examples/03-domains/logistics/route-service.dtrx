from logistics.common import ShipmentStatus;

// A route is a van, a driver, a day and an ordered list of stops. A dispatcher fills a draft and sends it
// out; a stop will not go on a route whose van cannot carry it. A driver sees only their own routes, and
// each stop they finish is reported back to the parcel.
service logistics.RouteService('config/route-service.dcfg') : version('2.0.0'), description('Routes and stops') {

    discovery { }

    uses ShipmentService;
    uses FleetService;

    exceptions {
        OverCapacityError : status(409), message("That parcel would overload this van");
        RouteNotOpenError : status(409), message("This route has already gone out");
        StopTakenError : status(409), message("That parcel is already on a route");
        EmptyRouteError : status(409), message("Add a stop before sending this route out");
        NotYourRouteError : status(404), message("Route not found");
        StopNotOpenError : status(409), message("This stop is already finished");
    }

    enum RouteStatus {
        Draft : tone(warning),
        Out : tone(info),
        Finished : tone(success)
    }

    enum StopStatus {
        Waiting : tone(warning),
        Planned : tone(info),
        OnTheRoad : tone(info),
        Delivered : tone(success),
        Failed : tone(danger)
    }

    /// Why a driver could not hand a parcel over.
    enum MissReason {
        NobodyHome,
        AddressWrong,
        Refused,
        CouldNotReach
    }

    const KM_PER_DEGREE = 111.0;
    const ROAD_FACTOR = 1.3;

    rdbms routeDb {

        entity DeliveryRoute extends BaseEntity {
            String(120) name : filterable;
            DateTime runsOn;
            RouteStatus status : filterable = RouteStatus.Draft;
            String(200) driverName : filterable;
            String(60) vehicleName;
            Int stopCount = 0;
            Int doneCount = 0;
            Float loadKg = 0.0;
            Float capacityKg;
            Float distanceKm = 0.0;
            Email driverEmail : index;
            UUID vehicleId;
        }

        entity Stop extends BaseEntity {
            String(20) trackingNumber : filterable;
            String(200) recipientName : filterable;
            String(300) address;
            String(100) city : filterable;
            Float weightKg;
            StopStatus status : filterable = StopStatus.Waiting;
            Int sequence = 0;
            String(200)? deliveredTo;
            MissReason? missReason;
            UUID shipmentId : unique;
            UUID? routeId : index;
            Float latitude;
            Float longitude;
        }
    }

    // A service reads another service's topics through a pubsub block of its own.
    pubsub mq { }

    subscribe ShipmentEvents {
        // The same parcel comes back here after a failed attempt, and waits again.
        on ShipmentBooked(UUID shipmentId, String trackingNumber, String recipientName, String address, String city, Float latitude, Float longitude, Float weightKg) {
            let routeDb.Stop? known = routeDb.Stop.where(shipmentId: shipmentId).first();
            if (known == null) {
                routeDb.Stop.create({
                    shipmentId: shipmentId,
                    trackingNumber: trackingNumber,
                    recipientName: recipientName,
                    address: address,
                    city: city,
                    weightKg: weightKg,
                    latitude: latitude,
                    longitude: longitude
                });
            } else {
                known.status = StopStatus.Waiting;
                known.routeId = null;
                known.missReason = null;
                known.save();
            }
        }
    }

    struct NewRoute {
        String(120) name;
        DateTime runsOn;
        UUID driverId;
        UUID vehicleId;
    }

    struct AddStopRequest {
        UUID stopId;
        UUID routeId;
    }

    struct DeliveredRequest {
        UUID stopId;
        String(200) deliveredTo;
    }

    struct MissedRequest {
        UUID stopId;
        MissReason reason;
    }

    struct StopPin {
        UUID id;
        Int sequence;
        String recipientName;
        String address;
        String city;
        String trackingNumber;
        Float weightKg;
        StopStatus status;
        GeoPoint point;
    }

    struct RouteView {
        routeDb.DeliveryRoute route;
        Array<StopPin> stops;
        Array<GeoPoint> line;
    }

    fn legKm(Float fromLatitude, Float fromLongitude, Float toLatitude, Float toLongitude) -> Float {
        let Float northSouth = Math.abs(fromLatitude - toLatitude) * KM_PER_DEGREE;
        let Float eastWest = Math.abs(fromLongitude - toLongitude) * KM_PER_DEGREE * 0.7;
        return Math.sqrt(northSouth * northSouth + eastWest * eastWest) * ROAD_FACTOR;
    }

    fn pinOf(routeDb.Stop stop) -> StopPin {
        return StopPin {
            id: stop.id,
            sequence: stop.sequence,
            recipientName: stop.recipientName,
            address: stop.address,
            city: stop.city,
            trackingNumber: stop.trackingNumber,
            weightKg: stop.weightKg,
            status: stop.status,
            point: GeoPoint { latitude: stop.latitude, longitude: stop.longitude }
        };
    }

    fn viewOf(routeDb.DeliveryRoute route) -> RouteView {
        let Array<routeDb.Stop> stops = routeDb.Stop.where(routeId: route.id).orderBy(sequence: asc).limit(100).all();
        return RouteView {
            route: route,
            stops: stops.map(s => pinOf(s)),
            line: stops.map(s => GeoPoint { latitude: s.latitude, longitude: s.longitude })
        };
    }

    /// The load, the count and the distance always come from the stops themselves.
    fn recount(routeDb.DeliveryRoute route) {
        let Array<routeDb.Stop> stops = routeDb.Stop.where(routeId: route.id).orderBy(sequence: asc).limit(100).all();
        let Float load = 0.0;
        let Float distance = 0.0;
        let Boolean first = true;
        let Float lastLatitude = 0.0;
        let Float lastLongitude = 0.0;
        foreach stop in stops {
            load = load + stop.weightKg;
            if (!first) {
                distance = distance + legKm(lastLatitude, lastLongitude, stop.latitude, stop.longitude);
            }
            first = false;
            lastLatitude = stop.latitude;
            lastLongitude = stop.longitude;
        }
        route.stopCount = stops.length;
        route.loadKg = load;
        route.distanceKm = Math.round(distance, 1);
        route.save();
    }

    fn ownRoute(UUID id) -> routeDb.DeliveryRoute {
        let routeDb.DeliveryRoute route = routeDb.DeliveryRoute.findOrFail(id);
        if (route.driverEmail.toString() != Auth.identity.email.toString()) {
            throw NotYourRouteError();
        }
        return route;
    }

    fn ownOpenStop(UUID id) -> routeDb.Stop {
        let routeDb.Stop stop = routeDb.Stop.findOrFail(id);
        if (stop.routeId == null) {
            throw NotYourRouteError();
        }
        ownRoute(stop.routeId);
        if (stop.status != StopStatus.OnTheRoad) {
            throw StopNotOpenError();
        }
        return stop;
    }

    /// A stop finished: count it, and when it was the last one, the van has done the distance.
    fn stopFinished(routeDb.Stop stop) {
        if (stop.routeId != null) {
            let routeDb.DeliveryRoute route = routeDb.DeliveryRoute.findOrFail(stop.routeId);
            route.doneCount = route.doneCount + 1;
            if (route.doneCount >= route.stopCount) {
                route.status = RouteStatus.Finished;
                FleetService.FleetInternalAPI.post.addDistance({ vehicleId: route.vehicleId, distanceKm: Math.ceil(route.distanceKm).toInteger() });
            }
            route.save();
        }
    }

    // How a dispatcher plans the day.
    rest_api PlanningAPI : basePath('/api/v1/desk/routes'), rdbms(routeDb) {
        resource DeliveryRoute : only(list), auth(required, providers: [identity], roles: [dispatcher]);
        resource Stop : only(list), auth(required, providers: [identity], roles: [dispatcher]);

        @path('/open')
        get openRoutes() : auth(required, providers: [identity], roles: [dispatcher]) -> Array<DeliveryRoute> {
            return DeliveryRoute.where(status: RouteStatus.Draft).orderBy(runsOn: asc).limit(50).all();
        }

        @path('/running')
        get running() : auth(required, providers: [identity], roles: [dispatcher]) -> Array<DeliveryRoute> {
            return DeliveryRoute.where(runsOn: gte(DateTime.now().startOfDay())).orderBy(runsOn: asc).limit(50).all();
        }

        @path('/waiting')
        get waiting() : auth(required, providers: [identity], roles: [dispatcher]) -> Array<Stop> {
            return Stop.where(status: StopStatus.Waiting).orderBy(createdAt: asc).limit(100).all();
        }

        @path('/route/:id')
        get detail(UUID id) : auth(required, providers: [identity], roles: [dispatcher]) -> RouteView {
            return viewOf(DeliveryRoute.findOrFail(id));
        }

        @path('/new')
        post createRoute(NewRoute request) : auth(required, providers: [identity], roles: [dispatcher]) -> DeliveryRoute {
            let Assignment assigned = FleetService.FleetInternalAPI.get.assignment(driverId: request.driverId, vehicleId: request.vehicleId);
            return DeliveryRoute.create({
                name: request.name,
                runsOn: request.runsOn,
                driverName: assigned.driverName,
                driverEmail: assigned.driverEmail,
                vehicleName: assigned.vehicleName,
                vehicleId: request.vehicleId,
                capacityKg: assigned.capacityKg
            });
        }

        // Two dispatchers adding to one van at once cannot overload it, because each locks the route.
        @path('/stops/add')
        post addStop(AddStopRequest request) : auth(required, providers: [identity], roles: [dispatcher]) -> DeliveryRoute {
            transaction(routeDb) {
                let DeliveryRoute route = DeliveryRoute.where(id: request.routeId).forUpdate().firstOrFail();
                let Stop stop = Stop.where(id: request.stopId).forUpdate().firstOrFail();
                if (route.status != RouteStatus.Draft) {
                    throw RouteNotOpenError();
                }
                if (stop.status != StopStatus.Waiting) {
                    throw StopTakenError();
                }
                if (route.loadKg + stop.weightKg > route.capacityKg) {
                    throw OverCapacityError();
                }
                stop.routeId = route.id;
                stop.status = StopStatus.Planned;
                stop.sequence = route.stopCount + 1;
                stop.save();
                recount(route);
            }
            let Stop placed = Stop.findOrFail(request.stopId);
            let DeliveryRoute updated = DeliveryRoute.findOrFail(request.routeId);
            ShipmentService.ShipmentInternalAPI.post.report({
                shipmentId: placed.shipmentId,
                status: ShipmentStatus.Planned,
                note: #"Planned for delivery on {updated.runsOn.format('MMM dd')}"
            });
            return updated;
        }

        @path('/stops/:id/remove')
        post removeStop(UUID id) : auth(required, providers: [identity], roles: [dispatcher]) -> Stop {
            let Stop stop = Stop.findOrFail(id);
            if (stop.routeId == null) {
                throw RouteNotOpenError();
            }
            let DeliveryRoute route = DeliveryRoute.findOrFail(stop.routeId);
            if (route.status != RouteStatus.Draft) {
                throw RouteNotOpenError();
            }
            stop.routeId = null;
            stop.status = StopStatus.Waiting;
            stop.sequence = 0;
            stop.save();
            recount(route);
            ShipmentService.ShipmentInternalAPI.post.report({ shipmentId: stop.shipmentId, status: ShipmentStatus.Booked, note: "Waiting for a route" });
            return stop;
        }

        @path('/route/:id/send')
        post send(UUID id) : auth(required, providers: [identity], roles: [dispatcher]) -> DeliveryRoute {
            let DeliveryRoute route = DeliveryRoute.findOrFail(id);
            if (route.status != RouteStatus.Draft) {
                throw RouteNotOpenError();
            }
            if (route.stopCount == 0) {
                throw EmptyRouteError();
            }
            route.status = RouteStatus.Out;
            route.save();
            let Array<Stop> stops = Stop.where(routeId: id).limit(100).all();
            foreach stop in stops {
                stop.status = StopStatus.OnTheRoad;
                stop.save();
                ShipmentService.ShipmentInternalAPI.post.report({
                    shipmentId: stop.shipmentId,
                    status: ShipmentStatus.OutForDelivery,
                    note: "Out for delivery today",
                    driverName: route.driverName
                });
            }
            return route;
        }
    }

    // What a driver works with. Every read and write is checked against the signed-in driver's address.
    rest_api DriverRouteAPI : basePath('/api/v1/driver'), rdbms(routeDb) {
        @path('/routes')
        get myRoutes() : auth(required, providers: [identity], roles: [driver]) -> Array<DeliveryRoute> {
            return DeliveryRoute.where(driverEmail: Auth.identity.email).orderBy(runsOn: desc).limit(30).all();
        }

        @path('/routes/:id')
        get run(UUID id) : auth(required, providers: [identity], roles: [driver]) -> RouteView {
            return viewOf(ownRoute(id));
        }

        @path('/stops/delivered')
        post delivered(DeliveredRequest request) : auth(required, providers: [identity], roles: [driver]) -> Stop {
            let Stop stop = ownOpenStop(request.stopId);
            stop.status = StopStatus.Delivered;
            stop.deliveredTo = request.deliveredTo;
            stop.save();
            ShipmentService.ShipmentInternalAPI.post.report({
                shipmentId: stop.shipmentId,
                status: ShipmentStatus.Delivered,
                note: "Delivered",
                deliveredTo: request.deliveredTo
            });
            stopFinished(stop);
            return stop;
        }

        @path('/stops/missed')
        post missed(MissedRequest request) : auth(required, providers: [identity], roles: [driver]) -> Stop {
            let Stop stop = ownOpenStop(request.stopId);
            stop.status = StopStatus.Failed;
            stop.missReason = request.reason;
            stop.save();
            ShipmentService.ShipmentInternalAPI.post.report({
                shipmentId: stop.shipmentId,
                status: ShipmentStatus.Failed,
                note: "We could not deliver today",
                failureReason: request.reason.toString()
            });
            stopFinished(stop);
            return stop;
        }
    }

    test("a road is longer than the straight line") {
        assert legKm(45.50, -122.60, 45.60, -122.60) > 11.1;
    }

    test("a new route has nothing on it") {
        let routeDb.DeliveryRoute route = routeDb.DeliveryRoute.create({
            name: "North loop",
            runsOn: DateTime.now(),
            driverName: "Ines Calder",
            driverEmail: "ines@quayline.example.com",
            vehicleName: "Van 1",
            vehicleId: uuid(),
            capacityKg: 900.0
        });
        assert route.status == RouteStatus.Draft;
        assert route.stopCount == 0;
    }
}
