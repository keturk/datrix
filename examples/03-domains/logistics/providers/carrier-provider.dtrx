// The contract of the partner carrier that delivers outside Quayline's own area.
// config/providers/carrier-provider.dcfg says where it is served.
extern service logistics.CarrierProvider('config/providers/carrier-provider.dcfg')
    : version('1.0.0'), description('A partner carrier') {

    enum ConsignmentStatus {
        Accepted,
        InTransit,
        Delivered
    }

    struct CreateConsignmentRequest {
        String(20) trackingNumber;
        String(200) recipientName;
        String(300) address;
        String(100) city;
        Float weightKg;
        /// The caller's key: consigning again with the same key returns the first consignment.
        String(120) idempotencyKey;
    }

    struct Consignment {
        String(40) reference;
        ConsignmentStatus status;
        String(200)? signedBy;
    }

    rest_api CarrierAPI : basePath('/v1') {
        @path('/consignments')
        post createConsignment(CreateConsignmentRequest request) -> Consignment {
            ensure request.weightKg > 0;
            ensure request.idempotencyKey != "";
        }

        @path('/consignments/{reference}')
        get consignment(String reference) -> Consignment;
    }

    errors {
        UnknownConsignment(String message);
    }

    auth : apiKey(header: 'X-Carrier-Api-Key');
    health : path('/health');
}
