config service logistics.ShipmentService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms shipmentDb from postgresContainer(id: "457ecc79-f5c1-4fb1-a780-6d9139e5b627", database: "logistics_shipment");
    pubsub mq from kafkaContainer();
    queues from rabbitContainer();
    httpSecurity from localHttpSecurity(host: "logistics-shipment-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    queueOps from queuePolling();
    messagingOps from rabbitPrefetch();
    serviceCredentialOps from machineCredential();
    jobs {
      jobs {
        SyncPartnerConsignments {
          schedule = "*/2 * * * *";
          timeout = "120s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The defaults only exist on a local stack, where they match the hashes seeded in seed/, so the
      // example runs with nothing to configure. Any other deployment must supply the handles' values.
      secret carrier_provider_api_key {
        required = true;
        purpose = "API key for the partner carrier (CarrierProvider contract).";
        localDefault = "dev-only-carrier-key-not-a-credential";
      }
      secret geocode_provider_api_key {
        required = true;
        purpose = "API key for the geocoding vendor (GeocodeProvider contract).";
        localDefault = "dev-only-geocode-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
