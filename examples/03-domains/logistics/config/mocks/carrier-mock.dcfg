config service logistics.CarrierMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8090;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms carrierDb from postgresContainer(id: "3f29a643-52ab-4fd2-82c0-06431e6f3d51", database: "logistics_carrier_mock");
    httpSecurity from localHttpSecurity(host: "logistics-carrier-mock");
    serviceCredentialOps from machineCredential();
    jobs {
      jobs {
        AdvanceConsignments {
          schedule = "* * * * *";
          timeout = "60s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
