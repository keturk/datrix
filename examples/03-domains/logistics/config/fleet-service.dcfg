config service logistics.FleetService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8002;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms fleetDb from postgresContainer(id: "d9cd4cf0-4e04-415d-a945-80f786704d5f", database: "logistics_fleet");
    httpSecurity from localHttpSecurity(host: "logistics-fleet-service");
    serviceCredentialOps from machineCredential();
    jobs {
      jobs {
        FlagVehiclesDue {
          schedule = "0 5 * * *";
          timeout = "120s";
        }
      }
    }
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
