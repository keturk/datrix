config service logistics.NoticeService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8004;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms noticeDb from postgresContainer(id: "87b71561-e3d7-46f2-8114-fbbe457dcba6", database: "logistics_notice");
    httpSecurity from localHttpSecurity(host: "logistics-notice-service");
    queueOps from queuePolling();
    messagingOps from rabbitPrefetch();
    serviceCredentialOps from machineCredential();
    microserviceClientOps from peerClient();
    retryBudgetOps from retryBudget();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in seed/, so the
      // example runs with nothing to configure. Any other deployment must supply the handle's value.
      secret sms_provider_api_key {
        required = true;
        purpose = "API key for the text message vendor (SmsProvider contract).";
        localDefault = "dev-only-sms-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
