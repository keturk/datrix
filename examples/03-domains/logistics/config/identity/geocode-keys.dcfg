// API keys of the geocoding vendor. mode = self: GeocodeMock issues and verifies them itself, and only the
// SHA-256 hash of a key is stored.
config identity geocodeKeys {
  base {
    provider = "apiKey";
    mode = "self";
    audience = "workforce";
    apiKey {
      header = "X-Geocode-Api-Key";
      store = "logistics.GeocodeMock";
      storeBlock = "geocodeDb";
      entity = "ApiKey";
      fields {
        hash = "keyHash";
        owner = "ownerId";
        scopes = "scopes";
        active = "isActive";
        expiresAt = "expiresAt";
        lastUsedAt = "lastUsedAt";
      }
      lastUsedResolutionSeconds = 60;
      serviceProviders = ["machine"];
    }
  }

  profile test as "test" extends base {
  }

  profile development as "dev" extends base {
  }

  profile production as "prod" extends base {
  }
}
