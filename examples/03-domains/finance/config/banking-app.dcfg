config app finance.Banking {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@quillon";
      }
    }
    appId = "com.example.quillon";
    strings = ["config/strings/banking.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
