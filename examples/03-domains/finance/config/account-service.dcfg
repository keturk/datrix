config service finance.AccountService {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8001;
    language = "python";  // ComplianceService's agent needs Python, and one system generates in one language.
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms accountDb from postgresContainer(id: "e35d42d1-b104-4438-a1ac-00c9ad13042e", database: "finance_account");
    pubsub mq from kafkaContainer();
    httpSecurity from localHttpSecurity(host: "finance-account-service");
    outboxOps from outboxBatches();
    kafkaOps from kafkaPolling();
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
    secrets {
      // The default only exists on a local stack, where it matches the hash seeded in
      // seed/kyc-mock.dseed, so the example runs with nothing to configure. Any other deployment
      // must supply the handle's value.
      secret kyc_provider_api_key {
        required = true;
        purpose = "API key for the identity check vendor (KycProvider contract).";
        localDefault = "dev-only-kyc-key-not-a-credential";
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
