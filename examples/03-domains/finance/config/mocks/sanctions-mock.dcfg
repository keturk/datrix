config service finance.SanctionsMock {
  import "config/templates/infrastructure.dcfg";

  base {
    port = 8092;
    replicas = 1;
    healthCheck {
      path = "/health";
      initialDelay = "10s";
    }
    rdbms sanctionsDb from postgresContainer(id: "8b2e4d71-c5a6-4f93-b018-6d3f7a29c0e4", database: "finance_sanctions_mock");
    httpSecurity from localHttpSecurity(host: "finance-sanctions-mock");
    serviceCredentialOps from machineCredential();
    resilience {
      defaults {
        timeout = "10s";
      }
      dependencyPolicy {
        defaults {
          rdbms from standardDatabasePolicy();
        }
      }
    }
  }

  profile test as "test" extends base {
    alias env = "TEST";
    alias resource = "test";
  }

  profile development as "dev" extends base {
    alias env = "DEV";
    alias resource = "dev";
  }

  profile production as "prod" extends base {
    alias env = "PROD";
    alias resource = "prod";
  }
}
