from finance.common import AccountStatus, AccountType;

// Compliance watches the bank from its events and stops nothing itself: a large transfer raises an
// alert for a person, a sanctions hit raises a critical one, and every account and alert change
// goes in an audit trail the database itself keeps append-only.
service finance.ComplianceService('config/compliance-service.dcfg') : version('2.0.0'), description('Alerts and the audit trail') {

    discovery { }

    uses AccountService;
    uses TransactionService;

    exceptions {
        AlertAlreadyClosedError : status(409), message("This alert has already been closed");
    }

    enum AlertType {
        LargeTransfer,
        SanctionsHit,
        AccountFrozen
    }

    enum AlertSeverity {
        Medium : tone(warning),
        Critical : tone(danger)
    }

    enum AlertStatus {
        Open : tone(warning),
        Closed : tone(neutral)
    }

    rdbms complianceDb {

        entity ComplianceAlert extends BaseEntity {
            AlertType type : filterable;
            AlertSeverity severity : filterable;
            AlertStatus status : filterable = AlertStatus.Open;
            String(30) subject : filterable;
            String(500) reason;
            Money? amount;
            UUID? reviewedBy;
            String(500)? reviewNote;

            index(status, severity);
        }

        /// What happened to accounts and alerts, in order. The table refuses every change and delete.
        entity AuditEvent extends BaseEntity : appendOnly {
            String(60) action : filterable;
            String(30) subject : filterable;
            String(500) detail;
        }

        /// One day's count of alerts raised.
        entity DailyReport extends BaseEntity : appendOnly {
            DateTime day : unique, sortable;
            Int alertsRaised;
            Int criticalAlerts;
            Int stillOpen;
        }
    }

    fn audit(String action, String subject, String detail) {
        complianceDb.AuditEvent.create({ action: action, subject: subject, detail: detail });
    }

    subscribe TransferEvents {
        on TransferPosted(UUID transferId, String reference, UUID fromAccountId, Money amount, Boolean needsReview) {
            if (needsReview) {
                complianceDb.ComplianceAlert.create({
                    type: AlertType.LargeTransfer,
                    severity: AlertSeverity.Medium,
                    subject: reference,
                    reason: "A transfer reached the review threshold.",
                    amount: amount
                });
                audit("alert.raised", reference, "Large transfer");
            }
        }

        on TransferHeld(UUID transferId, String reference, UUID fromAccountId, Money amount, String reason) {
            complianceDb.ComplianceAlert.create({
                type: AlertType.SanctionsHit,
                severity: AlertSeverity.Critical,
                subject: reference,
                reason: reason,
                amount: amount
            });
            audit("alert.raised", reference, reason);
        }
    }

    subscribe AccountEvents {
        on AccountOpened(UUID accountId, String accountNumber, UUID ownerUserId, AccountType type) {
            audit("account.opened", accountNumber, #"Opened as {type}");
        }

        on AccountStatusChanged(UUID accountId, String accountNumber, AccountStatus oldStatus, AccountStatus newStatus) {
            audit("account.status", accountNumber, #"{oldStatus} to {newStatus}");
            if (newStatus == AccountStatus.Frozen) {
                complianceDb.ComplianceAlert.create({
                    type: AlertType.AccountFrozen,
                    severity: AlertSeverity.Medium,
                    subject: accountNumber,
                    reason: "An officer froze this account."
                });
            }
        }
    }

    struct CloseAlertRequest {
        UUID alertId;
        String(500) note;
    }

    struct AlertSummary {
        Int open;
        Int critical;
    }

    rest_api ComplianceAPI : basePath('/api/v1/compliance'), rdbms(complianceDb) {
        resource ComplianceAlert : only(list, get), auth(required, providers: [identity], roles: [officer]);
        resource AuditEvent : only(list), auth(required, providers: [identity], roles: [officer]);
        resource DailyReport : only(list), auth(required, providers: [identity], roles: [officer]);

        @path('/summary')
        get summary() : auth(required, providers: [identity], roles: [officer]) -> AlertSummary {
            return AlertSummary {
                open: ComplianceAlert.where(status: AlertStatus.Open).count(),
                critical: ComplianceAlert.where(status: AlertStatus.Open, severity: AlertSeverity.Critical).count()
            };
        }

        @path('/alerts/close')
        post closeAlert(CloseAlertRequest request) : auth(required, providers: [identity], roles: [officer]) -> ComplianceAlert {
            let ComplianceAlert alert = ComplianceAlert.findOrFail(request.alertId);
            if (alert.status == AlertStatus.Closed) {
                throw AlertAlreadyClosedError();
            }
            alert.status = AlertStatus.Closed;
            alert.reviewedBy = Auth.userId();
            alert.reviewNote = request.note;
            alert.save();
            audit("alert.closed", alert.subject, request.note);
            return alert;
        }
    }

    jobs {
        job ReportYesterday {
            let DateTime until = DateTime.now().startOfDay();
            let DateTime since = until.addDays(-1);
            if (complianceDb.DailyReport.where(day: since).first() == null) {
                let Array<complianceDb.ComplianceAlert> raised = complianceDb.ComplianceAlert.where(createdAt: gte(since)).where(createdAt: lt(until)).all();
                complianceDb.DailyReport.create({
                    day: since,
                    alertsRaised: raised.length,
                    criticalAlerts: raised.filter(a => a.severity == AlertSeverity.Critical).length,
                    stillOpen: complianceDb.ComplianceAlert.where(status: AlertStatus.Open).count()
                });
            }
        }
    }

    test("an alert starts open") {
        let ComplianceAlert alert = complianceDb.ComplianceAlert.create({
            type: AlertType.LargeTransfer,
            severity: AlertSeverity.Medium,
            subject: "TR-1",
            reason: "A transfer reached the review threshold."
        });
        assert alert.status == AlertStatus.Open;
    }
}
