config app hotel.Guest {
  base {
    targets = ["angular", "flutter"];
    clients {
      angular {
        scope = "@marram";
      }
    }
    appId = "com.example.marram";
    strings = ["config/strings/guest.en-US.dcfg"];
  }
  profile test as "test" extends base {
    web { port = 4200; }
  }
  profile development as "dev" extends base {
    web { port = 4200; }
  }
  profile production as "prod" extends base {
    web { port = 4200; }
  }
}
