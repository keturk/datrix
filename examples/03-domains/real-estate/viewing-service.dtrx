from realestate.common import ListingStatus;

// Going to see a home. A buyer asks for a time, the agent confirms it, and two confirmed viewings can never
// overlap for one agent. A viewing comes with a reminder the day before, and news of a price change.
service realestate.ViewingService('config/viewing-service.dcfg') : version('2.0.0'), description('Viewings') {

    discovery { }

    uses ListingService;
    uses EmailProvider;

    exceptions {
        NotOpenForViewingsError : status(409), message("That home is not taking viewings");
        InThePastError : status(422), message("Choose a time in the future");
        AgentBusyError : status(409), message("You already have a viewing at that time");
        NotYourViewingError : status(404), message("Viewing not found");
        WrongStepError : status(409), message("This viewing is not at that step");
    }

    enum ViewingStatus {
        Requested : tone(warning),
        Confirmed : tone(info),
        Completed : tone(success),
        Cancelled : tone(neutral),
        NoShow : tone(danger)
    }

    const VIEWING_MINUTES = 30;

    rdbms viewingDb {

        entity Viewing extends BaseEntity {
            DateTime startsAt;
            DateTime endsAt;
            String(200) listingTitle : filterable;
            String(200) buyerName : filterable;
            ViewingStatus status : filterable = ViewingStatus.Requested;
            String(200) agentName : filterable;
            String(500)? note;
            UUID listingId : index;
            Email buyerEmail : index;
            Email agentEmail : index;
            Boolean reminderSent = false;
        }
    }

    // A service reads another service's topics through a pubsub block of its own.
    pubsub mq { }

    subscribe ListingEvents {
        // Anyone still going to see the home should hear about it before they arrive.
        on ListingPriceChanged(UUID listingId, String title, Money oldPrice, Money newPrice) {
            let Array<viewingDb.Viewing> upcoming = viewingDb.Viewing
                .where(listingId: listingId)
                .whereIn(status: [ViewingStatus.Requested, ViewingStatus.Confirmed])
                .where(startsAt: gte(DateTime.now()))
                .limit(100)
                .all();
            foreach viewing in upcoming {
                sendMail(viewing.buyerEmail.toString(), #"New price for {title}", #"The home you are going to see now asks ${newPrice.toString()}.", #"price-{viewing.id}-{newPrice.toString()}");
            }
        }
    }

    struct RequestViewing {
        UUID listingId;
        DateTime startsAt;
        String(500)? note;
    }

    struct DayLoad {
        String day;
        Int viewings;
    }

    struct ViewingSummary {
        Int waitingForYou;
        Int nextSevenDays;
        Array<DayLoad> ahead;
    }

    fn sendMail(String to, String subject, String body, String key) {
        try {
            EmailProvider.EmailAPI.post.sendEmail(SendEmailRequest { to: to, subject: subject, body: body, idempotencyKey: key });
        } catch (Exception e) {
            Log.warn("Email not sent", { key: key });
        }
    }

    fn ownAsAgent(UUID id) -> viewingDb.Viewing {
        let viewingDb.Viewing viewing = viewingDb.Viewing.findOrFail(id);
        if (viewing.agentEmail.toString() != Auth.identity.email.toString()) {
            throw NotYourViewingError();
        }
        return viewing;
    }

    fn dayLoad(String agent, Int daysAhead) -> DayLoad {
        let DateTime start = DateTime.now().startOfDay().addDays(daysAhead);
        return DayLoad {
            day: start.format('MMM dd'),
            viewings: viewingDb.Viewing.where(agentEmail: agent, status: ViewingStatus.Confirmed).where(startsAt: gte(start)).where(startsAt: lt(start.addDays(1))).count()
        };
    }

    // What a buyer does. Every read is scoped to whoever signed in.
    rest_api BuyerViewingAPI : basePath('/api/v1/viewings'), rdbms(viewingDb) {
        @path('/mine')
        get mine() : auth(required, providers: [identity]) -> Array<Viewing> {
            return Viewing.where(buyerEmail: Auth.identity.email).orderBy(startsAt: desc).limit(50).all();
        }

        @path('/request')
        post requestViewing(RequestViewing request) : auth(required, providers: [identity]) -> Viewing {
            let ListingFacts listing = ListingService.ListingInternalAPI.get.facts(id: request.listingId);
            if (listing.status != ListingStatus.Active) {
                throw NotOpenForViewingsError();
            }
            if (request.startsAt < DateTime.now()) {
                throw InThePastError();
            }
            return Viewing.create({
                listingId: request.listingId,
                listingTitle: listing.title,
                startsAt: request.startsAt,
                endsAt: request.startsAt.addMinutes(VIEWING_MINUTES),
                note: request.note,
                buyerName: (Auth.identity.fullName ?? Auth.identity.email).toString(),
                buyerEmail: Auth.identity.email,
                agentName: listing.agentName,
                agentEmail: listing.agentEmail
            });
        }

        @path('/cancel/:id')
        post cancel(UUID id) : auth(required, providers: [identity]) -> Viewing {
            let Viewing? viewing = Viewing.where(id: id, buyerEmail: Auth.identity.email).first();
            if (viewing == null) {
                throw NotYourViewingError();
            }
            viewing.status = ViewingStatus.Cancelled;
            viewing.save();
            return viewing;
        }
    }

    // What an agent does.
    rest_api AgentViewingAPI : basePath('/api/v1/agent/viewings'), rdbms(viewingDb) {
        resource Viewing : only(list), auth(required, providers: [identity], roles: [agent]);

        @path('/summary')
        get summary() : auth(required, providers: [identity], roles: [agent]) -> ViewingSummary {
            let String me = Auth.identity.email.toString();
            let Array<Int> days = [0, 1, 2, 3, 4, 5, 6];
            return ViewingSummary {
                waitingForYou: Viewing.where(agentEmail: me, status: ViewingStatus.Requested).count(),
                nextSevenDays: Viewing.where(agentEmail: me, status: ViewingStatus.Confirmed).where(startsAt: gte(DateTime.now())).where(startsAt: lt(DateTime.now().addDays(7))).count(),
                ahead: days.map(d => dayLoad(me, d))
            };
        }

        @path('/calendar')
        get calendar() : auth(required, providers: [identity], roles: [agent]) -> Array<Viewing> {
            return Viewing.where(agentEmail: Auth.identity.email, status: ViewingStatus.Confirmed).orderBy(startsAt: asc).limit(200).all();
        }

        @path('/confirm/:id')
        post confirm(UUID id) : auth(required, providers: [identity], roles: [agent]) -> Viewing {
            let Viewing viewing = ownAsAgent(id);
            if (viewing.status != ViewingStatus.Requested) {
                throw WrongStepError();
            }
            let Int clashes = Viewing
                .where(agentEmail: viewing.agentEmail, status: ViewingStatus.Confirmed)
                .where(startsAt: gte(viewing.startsAt.addMinutes(-VIEWING_MINUTES + 1)))
                .where(startsAt: lt(viewing.endsAt))
                .count();
            if (clashes > 0) {
                throw AgentBusyError();
            }
            viewing.status = ViewingStatus.Confirmed;
            viewing.save();
            sendMail(viewing.buyerEmail.toString(), #"Your viewing of {viewing.listingTitle}", #"{viewing.agentName} will meet you on {viewing.startsAt.format('MMM dd')} at {viewing.startsAt.format('HH:mm')}.", #"confirmed-{viewing.id}");
            return viewing;
        }

        @path('/completed/:id')
        post completed(UUID id) : auth(required, providers: [identity], roles: [agent]) -> Viewing {
            let Viewing viewing = ownAsAgent(id);
            if (viewing.status != ViewingStatus.Confirmed) {
                throw WrongStepError();
            }
            viewing.status = ViewingStatus.Completed;
            viewing.save();
            return viewing;
        }

        @path('/no-show/:id')
        post noShow(UUID id) : auth(required, providers: [identity], roles: [agent]) -> Viewing {
            let Viewing viewing = ownAsAgent(id);
            if (viewing.status != ViewingStatus.Confirmed) {
                throw WrongStepError();
            }
            viewing.status = ViewingStatus.NoShow;
            viewing.save();
            return viewing;
        }
    }

    jobs {
        // Everyone with a confirmed viewing in the next day gets one reminder.
        job RemindTomorrowsViewings {
            let Array<viewingDb.Viewing> soon = viewingDb.Viewing
                .where(status: ViewingStatus.Confirmed, reminderSent: false)
                .where(startsAt: gte(DateTime.now()))
                .where(startsAt: lt(DateTime.now().addHours(24)))
                .limit(200)
                .all();
            foreach viewing in soon {
                sendMail(viewing.buyerEmail.toString(), #"Tomorrow: {viewing.listingTitle}", #"{viewing.agentName} will meet you at {viewing.startsAt.format('HH:mm')}.", #"reminder-{viewing.id}");
                viewing.reminderSent = true;
                viewing.save();
            }
        }
    }

    test("a new viewing waits for the agent") {
        let viewingDb.Viewing created = viewingDb.Viewing.create({
            listingId: uuid(),
            listingTitle: "Test home",
            startsAt: DateTime.now().addDays(1),
            endsAt: DateTime.now().addDays(1).addMinutes(VIEWING_MINUTES),
            buyerName: "Theo Marsh",
            buyerEmail: "theo@example.com",
            agentName: "Dana Whitlock",
            agentEmail: "dana@cobblestone.example.com"
        });
        assert created.status == ViewingStatus.Requested;
        assert created.reminderSent == false;
    }
}
