// Owns the application's identity block and the tenant-scoped API keys:
// issues a key to a signed-in caller and answers the keys' verification.
service tenantshop.AccountService('config/account-service.dcfg') : version('1.0.0'), description('tenant-scoped API key store') {

    discovery { }

    identity {
        provider identity config('config/identity/identity.dcfg') {
        }
        provider platform config('config/identity/platform.dcfg') {
        }
        // App-issued API keys; each key's scopes map to roles
        provider customerKeys config('config/identity/customer-keys.dcfg') {
            group "products:read" as productReader;
        }
    }

    struct IssueApiKeyRequest {
        Array<String> scopes;
        DateTime? expiresAt;
    }

    // The raw key is returned exactly once, in this response; only its hash is stored
    struct IssueApiKeyResponse {
        UUID id;
        String apiKey;
        String keyPrefix;
    }

    rdbms accountDb {

        // Issued API keys, each owned by one tenant. Only the SHA-256 hash of
        // a key is stored; keyPrefix is display-only.
        entity ApiKey extends BaseEntity with Tenantable {
            String(64) keyHash : unique;
            UUID ownerId : index;
            String(12) keyPrefix;
            Array<String> scopes;
            Boolean isActive = true;
            DateTime? expiresAt;
            DateTime? lastUsedAt;
            Integer rateLimit = 100;
        }

    }

    // Holds the per-key rate-limit counters
    cache redis {
        counter RequestCounter : prefix('requests:'), ttl(60);
    }

    rest_api AccountAPI : basePath('/api/v1'), rdbms(accountDb) {

        // Issues a 256-bit API key for the signed-in caller, in the request's tenant
        @path('/me/api-keys')
        post issueApiKey(IssueApiKeyRequest request) : auth(required, providers: [identity]) -> IssueApiKeyResponse {
            let String rawKey = Crypto.randomBytes(32);
            let String hash = Crypto.sha256(rawKey);
            let String prefix = rawKey.substring(0, 12);

            let ApiKey key = accountDb.ApiKey.create({
                keyHash: hash,
                ownerId: Auth.userId(),
                keyPrefix: prefix,
                scopes: request.scopes,
                isActive: true,
                expiresAt: request.expiresAt,
                rateLimit: 100
            });

            return {
                id: key.id,
                apiKey: rawKey,
                keyPrefix: prefix
            };
        }

    }
}
